//! Design tokens of DESIGN.md. Values are pushed from Rust (`theme.rs`) so the theme can
//! switch at runtime; never write a hex color in UI code.

export global Tokens {
    in property <color> surface-content;
    in property <color> surface-sidebar;
    in property <color> surface-toolbar;
    in property <color> surface-lcd;
    in property <color> surface-raised;
    in property <color> surface-field;
    in property <color> border-lcd;
    in property <color> border-raised;
    in property <color> separator;
    in property <color> separator-chrome;
    in property <color> fill-control;
    in property <color> fill-control-hover;
    in property <color> fill-icon-hover;
    in property <color> fill-icon-pressed;
    in property <color> fill-row-hover;
    in property <color> fill-row-pressed;
    in property <color> fill-row-zebra;
    in property <color> fill-sidebar-hover;
    in property <color> fill-sidebar-selected;
    in property <color> rail;
    in property <color> rail-fill;
    in property <color> scrubber-thumb;
    in property <color> scrollbar-thumb;
    in property <color> text-primary;
    in property <color> text-secondary;
    in property <color> text-tertiary;
    in property <color> text-on-accent;
    in property <color> accent;
    in property <color> accent-hover;
    in property <color> accent-pressed;
    in property <color> focus-ring;
    in property <color> status-ok;
    in property <color> status-ok-tint;
    in property <color> status-caution;
    in property <color> status-caution-tint;
    in property <color> shadow-artwork;
    in property <color> shadow-popover;
    in property <color> overlay-artwork-hover;
    in property <color> overlay-button;
    in property <color> overlay-button-hover;
    in property <color> overlay-icon;
    in property <color> spectrogram-label;
    in property <color> spectrogram-cutoff;
}
