import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-Medium.ttf";
import "../assets/fonts/Inter-SemiBold.ttf";
import "../assets/fonts/InterDisplay-Bold.ttf";
import { Palette } from "std-widgets.slint";
import { AddToPlaylistSheet, ArtistsView, RecentView, TracksView, QueuePanel, UpdatePanel, AlbumDetail, AlbumEditor, NowPlaying, PlaylistEditor, PlaylistView, AlbumsGrid, IconButton, Icons, Lcd, Popover, OutputSettings, SearchField, SidebarHeader, SidebarItem, VolumeSlider, Icon, Txt, TextRole } from "components.slint";
import { AppState, SidebarSection, ViewKind } from "state.slint";
import { Tokens } from "tokens.slint";

export { AlbumCard, AppState, ArtistCard, LibraryTrackRow, DataCell, DetailInfo, PathStep, PlaylistItem, PlaylistTrackRow, QueueRow, TrackAction, TrackRowData, TrackSource, TrackTarget, SidebarSection, ViewKind } from "state.slint";
export { Tokens } from "tokens.slint";

export component AppWindow inherits Window {
    title: "Pistolame";
    icon: @image-url("../assets/app-icon/pistolame-256.png");
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 1100px;
    min-height: 700px;
    default-font-family: "Inter";
    default-font-size: 13px;
    background: Tokens.surface-content;

    property <bool> is-dark: AppState.is-dark;
    property <length> toolbar-width: root.width - 240px;
    // Right toolbar group: update dot (slot always reserved), volume, queue and output buttons.
    property <length> update-slot-width: 36px;
    // Same rule as the volume slider: adjustable unless the output is held exclusively.
    property <bool> is-volume-adjustable: !AppState.exclusive || AppState.is-shared;
    property <length> right-group-width: 200px + root.update-slot-width;
    property <length> lcd-width: Math.clamp(root.toolbar-width - 20px - 172px - root.right-group-width - 20px - 48px, 360px, 560px);
    property <length> side-gap: (root.toolbar-width - 20px - 172px - root.right-group-width - 20px - root.lcd-width) / 2;
    property <length> lcd-x: 20px + 172px + root.side-gap;
    property <length> lcd-right-window: 240px + root.lcd-x + root.lcd-width;

    // The std widgets (scrollbars) follow the theme through the Palette global.
    changed is-dark => {
        Palette.color-scheme = root.is-dark ? ColorScheme.dark : ColorScheme.light;
    }
    init => {
        Palette.color-scheme = root.is-dark ? ColorScheme.dark : ColorScheme.light;
        key-scope.focus();
    }

    // Cmd/Ctrl+Up/Down: one decibel at a time, shared mode only (exclusive mode leaves the
    // level to the DAC).
    function step-volume(decibels: float) {
        if root.is-volume-adjustable {
            AppState.volume-changed(Math.clamp(AppState.volume-decibels + decibels, -60, 0), false);
        }
    }

    // Closes the topmost open overlay, in z-order; false when nothing was open.
    function close-topmost-overlay() -> bool {
        if AppState.is-popover-open {
            AppState.is-popover-open = false;
            return true;
        }
        if AppState.is-album-editor-open {
            AppState.cancel-album-edit();
            return true;
        }
        if AppState.is-add-to-playlist-open {
            AppState.is-add-to-playlist-open = false;
            return true;
        }
        if AppState.is-playlist-editor-open {
            AppState.is-playlist-editor-open = false;
            return true;
        }
        if AppState.is-queue-open {
            AppState.is-queue-open = false;
            return true;
        }
        if AppState.is-update-panel-open {
            AppState.is-update-panel-open = false;
            return true;
        }
        return false;
    }

    // Back and Forward are ignored while a modal sheet is open (the Rust side guards too).
    function is-modal-sheet-open() -> bool {
        AppState.is-album-editor-open || AppState.is-playlist-editor-open || AppState.is-add-to-playlist-open
    }

    key-scope := FocusScope {
        key-pressed(event) => {
            if event.text == " " {
                AppState.toggle-play();
                return accept;
            }
            // Back and Forward come before the Escape test: Ctrl+[ arrives as ASCII ESC ("\u{1b}") and
            // Ctrl+] as "\u{1d}" on Windows and Linux. Slint reports Command as `control` on macOS.
            if (event.modifiers.control && (event.text == "[" || event.text == "\u{1b}")) || (event.modifiers.alt && event.text == Key.LeftArrow) {
                if !root.is-modal-sheet-open() { AppState.navigate-back(); }
                return accept;
            }
            if (event.modifiers.control && (event.text == "]" || event.text == "\u{1d}")) || (event.modifiers.alt && event.text == Key.RightArrow) {
                if !root.is-modal-sheet-open() { AppState.navigate-forward(); }
                return accept;
            }
            if event.text == Key.Escape {
                if !root.close-topmost-overlay() && AppState.is-sub-page {
                    AppState.navigate-back();
                }
                return accept;
            }
            if event.modifiers.control && (event.text == "t" || event.text == "T" || event.text == "\u{14}") {
                AppState.toggle-theme();
                return accept;
            }
            if event.modifiers.control && (event.text == "o" || event.text == "O") {
                if event.modifiers.shift { AppState.import-folder(); } else { AppState.import-files(); }
                return accept;
            }
            if event.modifiers.control && (event.text == "." ) { AppState.stop(); return accept; }
            // Slint reports the Command key as `control` on macOS.
            if event.modifiers.control && (event.text == "f" || event.text == "F") { search.focus-search(); return accept; }
            if event.modifiers.control && event.text == Key.RightArrow { AppState.next-track(); return accept; }
            if event.modifiers.control && event.text == Key.LeftArrow { AppState.previous-track(); return accept; }
            if event.modifiers.control && event.text == Key.UpArrow { root.step-volume(1); return accept; }
            if event.modifiers.control && event.text == Key.DownArrow { root.step-volume(-1); return accept; }
            if event.modifiers.control && (event.text == "l" || event.text == "L") { AppState.show-now-playing(); return accept; }
            if event.modifiers.control && event.text == "," { AppState.navigate-to-section(SidebarSection.settings); return accept; }
            if event.modifiers.control && event.text == "1" { AppState.navigate-to-section(SidebarSection.recently-added); return accept; }
            if event.modifiers.control && event.text == "2" { AppState.navigate-to-section(SidebarSection.artists); return accept; }
            if event.modifiers.control && event.text == "3" { AppState.navigate-to-section(SidebarSection.albums); return accept; }
            if event.modifiers.control && event.text == "4" { AppState.navigate-to-section(SidebarSection.tracks); return accept; }
            return reject;
        }

        // Clicks on empty areas take the keyboard focus back from the search field.
        TouchArea {
            clicked => {
                key-scope.focus();
            }
        }

        // Content region.
        Rectangle {
            x: 240px;
            y: 60px;
            width: root.toolbar-width;
            height: root.height - 60px;
            background: Tokens.surface-content;
            clip: true;
            AlbumsGrid {
                visible: AppState.view == ViewKind.grid;
            }

            AlbumDetail {
                visible: AppState.view == ViewKind.detail;
            }

            NowPlaying { visible: AppState.view == ViewKind.now-playing; }

            PlaylistView { visible: AppState.view == ViewKind.playlist; }

            ArtistsView { visible: AppState.view == ViewKind.artists; }
            TracksView { visible: AppState.view == ViewKind.tracks; }
            RecentView { visible: AppState.view == ViewKind.recently-added; }
        }

        OutputSettings {
            visible: AppState.view == ViewKind.settings;
            x: 272px; y: 84px; width: root.width - 304px; height: root.height - 116px;
        }
        // Toolbar.
        Rectangle {
            x: 240px;
            y: 0px;
            width: root.toolbar-width;
            height: 60px;
            background: Tokens.surface-toolbar;
            Rectangle {
                x: 0px;
                y: 59px;
                height: 1px;
                background: Tokens.separator-chrome;
            }

            IconButton {
                x: 20px;
                y: 16px;
                width: 28px;
                height: 28px;
                icon: Icons.shuffle;
                icon-size: 16px;
                icon-color: AppState.is-shuffle-on ? Tokens.accent : Tokens.text-secondary;
                label: "Aléatoire";
                clicked => {
                    AppState.is-shuffle-on = !AppState.is-shuffle-on;
                    key-scope.focus();
                }
            }

            IconButton {
                x: 52px;
                y: 14px;
                width: 32px;
                height: 32px;
                icon: Icons.skip-back-fill;
                icon-size: 18px;
                label: "Précédent";
                clicked => {
                    AppState.previous-track();
                    key-scope.focus();
                }
            }

            IconButton {
                x: 88px;
                y: 12px;
                width: 36px;
                height: 36px;
                icon: AppState.is-playing ? Icons.pause-fill : Icons.play-fill;
                icon-size: 22px;
                label: AppState.is-playing ? "Pause" : "Lecture";
                clicked => {
                    AppState.toggle-play();
                    key-scope.focus();
                }
            }

            IconButton {
                x: 128px;
                y: 14px;
                width: 32px;
                height: 32px;
                icon: Icons.skip-forward-fill;
                icon-size: 18px;
                label: "Suivant";
                clicked => {
                    AppState.next-track();
                    key-scope.focus();
                }
            }

            IconButton {
                x: 164px;
                y: 16px;
                width: 28px;
                height: 28px;
                icon: Icons.repeat;
                icon-size: 16px;
                icon-color: AppState.is-repeat-on ? Tokens.accent : Tokens.text-secondary;
                label: "Répéter";
                clicked => {
                    AppState.is-repeat-on = !AppState.is-repeat-on;
                    key-scope.focus();
                }
            }

            Lcd {
                x: root.lcd-x;
                y: 8px;
                width: root.lcd-width;
            }

            Rectangle {
                x: root.toolbar-width - 20px - root.right-group-width;
                y: 0px;
                width: root.right-group-width;
                height: 60px;
                if AppState.is-update-available: Rectangle {
                    x: 0px;
                    y: 16px;
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: update-touch.has-hover ? Tokens.status-ok-tint.darker(0.1) : Tokens.status-ok-tint;
                    accessible-role: button;
                    accessible-label: "Mise à jour disponible";
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: Tokens.status-ok;
                    }
                    update-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            AppState.is-update-panel-open = !AppState.is-update-panel-open;
                            AppState.is-popover-open = false;
                        }
                    }
                }

                // Click: mute / unmute (shared mode; greyed in exclusive mode like the slider).
                Image {
                    x: root.update-slot-width + 0px;
                    y: 23px;
                    width: 14px;
                    height: 14px;
                    source: AppState.is-volume-muted ? Icons.speaker-x : Icons.speaker-low;
                    colorize: mute-touch.has-hover && root.is-volume-adjustable ? Tokens.text-primary : Tokens.text-secondary;
                    opacity: root.is-volume-adjustable ? 1 : 0.4;
                    mute-touch := TouchArea {
                        x: -6px;
                        y: -6px;
                        width: parent.width + 12px;
                        height: parent.height + 12px;
                        accessible-role: button;
                        accessible-label: AppState.is-volume-muted ? "Rétablir le son" : "Couper le son";
                        clicked => {
                            if root.is-volume-adjustable {
                                AppState.volume-changed(AppState.volume-decibels, !AppState.is-volume-muted);
                            }
                        }
                    }
                }

                VolumeSlider {
                    x: root.update-slot-width + 20px;
                    y: 16px;
                }

                // Click: back to full level (0 dB).
                Image {
                    x: root.update-slot-width + 114px;
                    y: 23px;
                    width: 14px;
                    height: 14px;
                    source: Icons.speaker-high;
                    colorize: full-touch.has-hover && root.is-volume-adjustable ? Tokens.text-primary : Tokens.text-secondary;
                    opacity: root.is-volume-adjustable ? 1 : 0.4;
                    full-touch := TouchArea {
                        x: -6px;
                        y: -6px;
                        width: parent.width + 12px;
                        height: parent.height + 12px;
                        accessible-role: button;
                        accessible-label: "Volume maximal (0 dB)";
                        clicked => {
                            if root.is-volume-adjustable {
                                AppState.volume-changed(0, false);
                            }
                        }
                    }
                }

                IconButton {
                    x: root.update-slot-width + 140px;
                    y: 16px;
                    width: 28px;
                    height: 28px;
                    icon: Icons.queue;
                    icon-size: 18px;
                    icon-color: AppState.is-queue-open ? Tokens.accent : Tokens.text-secondary;
                    label: "À suivre";
                    clicked => {
                        AppState.is-queue-open = !AppState.is-queue-open;
                        AppState.is-popover-open = false;
                    }
                }

                IconButton {
                    x: root.update-slot-width + 172px;
                    y: 16px;
                    width: 28px;
                    height: 28px;
                    icon: Icons.speaker-hifi;
                    icon-size: 18px;
                    icon-color: AppState.is-popover-open ? Tokens.accent : Tokens.text-secondary;
                    label: "Sortie audio";
                    clicked => {
                        AppState.is-popover-open = !AppState.is-popover-open;
                    }
                }
            }
        }

        // Sidebar.
        Rectangle {
            x: 0px;
            y: 0px;
            width: 240px;
            height: root.height;
            background: Tokens.surface-sidebar;
            Rectangle {
                x: 239px;
                y: 0px;
                width: 1px;
                background: Tokens.separator-chrome;
            }

            // The running version, small and quiet, bottom left.
            Txt {
                x: 20px;
                y: parent.height - 26px;
                role: TextRole.caption;
                text: "v" + AppState.current-version;
                color: Tokens.text-tertiary;
                accessible-label: "Version " + AppState.current-version;
            }

            search := SearchField {
                x: 12px;
                y: 16px;
            }

            SidebarHeader {
                y: 60px;
                text: "Bibliothèque";
            }

            SidebarItem {
                y: 84px;
                icon: Icons.clock-counter-clockwise;
                label: "Ajouts récents";
                is-selected: AppState.section == SidebarSection.recently-added;
                clicked => {
                    AppState.navigate-to-section(SidebarSection.recently-added);
                    key-scope.focus();
                }
            }

            SidebarItem {
                y: 112px;
                icon: Icons.microphone-stage;
                label: "Artistes";
                is-selected: AppState.section == SidebarSection.artists;
                clicked => {
                    AppState.navigate-to-section(SidebarSection.artists);
                    key-scope.focus();
                }
            }

            SidebarItem {
                y: 140px;
                icon: Icons.vinyl-record;
                label: "Albums";
                is-selected: AppState.section == SidebarSection.albums;
                clicked => {
                    AppState.navigate-to-section(SidebarSection.albums);
                    key-scope.focus();
                }
            }

            SidebarItem {
                y: 168px;
                icon: Icons.music-note;
                label: "Morceaux";
                is-selected: AppState.section == SidebarSection.tracks;
                clicked => {
                    AppState.navigate-to-section(SidebarSection.tracks);
                    key-scope.focus();
                }
            }

            SidebarItem {
                y: 196px;
                icon: Icons.sliders-horizontal;
                label: "Réglages";
                is-selected: AppState.section == SidebarSection.settings;
                clicked => {
                    AppState.navigate-to-section(SidebarSection.settings);
                    key-scope.focus();
                }
            }

            SidebarHeader {
                y: 240px;
                text: "Playlists";
            }

            IconButton {
                x: 196px;
                y: 236px;
                width: 24px;
                height: 24px;
                icon: Icons.plus;
                icon-size: 14px;
                icon-color: Tokens.text-secondary;
                label: "Nouvelle playlist";
                clicked => {
                    AppState.create-playlist();
                    key-scope.focus();
                }
            }

            for item[index] in AppState.playlists: SidebarItem {
                y: 264px + 28px * index;
                icon: Icons.playlist;
                artwork: item.artwork;
                label: item.name;
                is-selected: AppState.section == SidebarSection.playlist && AppState.selected-playlist == index;
                clicked => {
                    AppState.open-playlist(index);
                    key-scope.focus();
                }
            }
        }

        if AppState.message != "": Rectangle {
            x: 260px; y: root.height - 62px; width: root.width - 280px; height: 48px;
            background: Tokens.surface-raised; border-radius: 6px;
            HorizontalLayout {
                padding: 8px; spacing: 8px;
                Text { text: AppState.message; color: Tokens.status-caution; wrap: word-wrap; }
                IconButton {
                    width: 24px; height: 24px; icon: Icons.x; icon-size: 14px;
                    icon-color: Tokens.text-secondary; label: "Fermer le message";
                    clicked => { AppState.message = ""; }
                }
            }
        }
        if AppState.is-update-panel-open: UpdatePanel {
            x: root.width - self.width - 20px;
            y: 64px;
        }
        if AppState.is-queue-open: QueuePanel {
            x: root.width - self.width;
            y: 60px;
            height: root.height - 60px;
        }
        if AppState.is-playlist-editor-open || AppState.is-add-to-playlist-open: Rectangle {
            background: #00000066;
            TouchArea { }
        }
        if AppState.is-playlist-editor-open: PlaylistEditor {
            x: (root.width - self.width) / 2;
            y: max(60px, (root.height - self.height) / 3);
        }
        if AppState.is-add-to-playlist-open: AddToPlaylistSheet {
            x: (root.width - self.width) / 2;
            y: max(60px, (root.height - self.height) / 3);
        }
        // Album editor sheet over a dimmed window; Escape or Annuler closes it.
        if AppState.is-album-editor-open: Rectangle {
            background: #00000066;
            TouchArea { }
        }
        if AppState.is-album-editor-open: AlbumEditor {
            x: (root.width - self.width) / 2;
            y: max(60px, (root.height - self.height) / 3);
        }
        // Popover layer: an outside click closes it.
        if AppState.is-popover-open: TouchArea {
            clicked => {
                AppState.is-popover-open = false;
                key-scope.focus();
            }
        }
        if AppState.is-popover-open: Popover {
            // Fades in and slides from y = 60 to 64; closing is instant.
            property <float> appear: 0;
            init => {
                self.appear = 1;
            }
            animate appear { duration: 200ms; easing: ease-out-quint; }
            x: root.lcd-right-window - 380px;
            y: 60px + 4px * self.appear;
            opacity: self.appear;
        }
        // Drop veil while files are dragged over the window.
        if AppState.is-drop-hovering: Rectangle {
            x: 8px;
            y: 8px;
            width: root.width - 16px;
            height: root.height - 16px;
            border-radius: 12px;
            border-width: 2px;
            border-color: Tokens.accent;
            background: Tokens.surface-content.with-alpha(0.9);
            VerticalLayout {
                alignment: center;
                spacing: 10px;
                Icon { height: 40px; source: Icons.plus; colorize: Tokens.accent; }
                Txt { role: TextRole.title-3; text: "Déposez pour ajouter à la bibliothèque"; horizontal-alignment: center; }
                Txt { text: "Dossiers et fichiers FLAC. Vos fichiers restent où ils sont."; color: Tokens.text-secondary; horizontal-alignment: center; }
            }
        }
    }
}
