import { Switch, ScrollView, ListView } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { AlbumCard, AppState, ArtistCard, LibraryTrackRow, DataCell, PathStep, QueueRow, TrackAction, TrackSource, ViewKind } from "state.slint";

export global Icons {
    out property <image> queue: @image-url("../assets/icons/queue.svg");
    out property <image> pencil-simple: @image-url("../assets/icons/pencil-simple.svg");
    out property <image> check: @image-url("../assets/icons/check.svg");
    out property <image> plus: @image-url("../assets/icons/plus.svg");
    out property <image> heart: @image-url("../assets/icons/heart.svg");
    out property <image> heart-fill: @image-url("../assets/icons/heart-fill.svg");
    out property <image> trash: @image-url("../assets/icons/trash.svg");
    out property <image> dots-three: @image-url("../assets/icons/dots-three.svg");
    out property <image> x: @image-url("../assets/icons/x.svg");
    out property <image> speaker-x: @image-url("../assets/icons/speaker-x.svg");
    out property <image> arrows-clockwise: @image-url("../assets/icons/arrows-clockwise.svg");
    out property <image> intersect: @image-url("../assets/icons/intersect.svg");
    out property <image> magnifying-glass: @image-url("../assets/icons/magnifying-glass.svg");
    out property <image> clock-counter-clockwise: @image-url("../assets/icons/clock-counter-clockwise.svg");
    out property <image> microphone-stage: @image-url("../assets/icons/microphone-stage.svg");
    out property <image> vinyl-record: @image-url("../assets/icons/vinyl-record.svg");
    out property <image> music-note: @image-url("../assets/icons/music-note.svg");
    out property <image> seal-check: @image-url("../assets/icons/seal-check.svg");
    out property <image> waveform: @image-url("../assets/icons/waveform.svg");
    out property <image> speaker-hifi: @image-url("../assets/icons/speaker-hifi.svg");
    out property <image> playlist: @image-url("../assets/icons/playlist.svg");
    out property <image> shuffle: @image-url("../assets/icons/shuffle.svg");
    out property <image> repeat: @image-url("../assets/icons/repeat.svg");
    out property <image> skip-back-fill: @image-url("../assets/icons/skip-back-fill.svg");
    out property <image> play-fill: @image-url("../assets/icons/play-fill.svg");
    out property <image> pause-fill: @image-url("../assets/icons/pause-fill.svg");
    out property <image> skip-forward-fill: @image-url("../assets/icons/skip-forward-fill.svg");
    out property <image> speaker-low: @image-url("../assets/icons/speaker-low.svg");
    out property <image> speaker-high: @image-url("../assets/icons/speaker-high.svg");
    out property <image> caret-left: @image-url("../assets/icons/caret-left.svg");
    out property <image> caret-up: @image-url("../assets/icons/caret-up.svg");
    out property <image> caret-down: @image-url("../assets/icons/caret-down.svg");
    out property <image> moon: @image-url("../assets/icons/moon.svg");
    out property <image> seal-check-fill: @image-url("../assets/icons/seal-check-fill.svg");
    out property <image> warning-fill: @image-url("../assets/icons/warning-fill.svg");
    out property <image> sliders-horizontal: @image-url("../assets/icons/sliders-horizontal.svg");
}

export enum TextRole {
    display,
    title-2,
    title-3,
    popover-title,
    headline,
    body-medium,
    body,
    callout,
    callout-medium,
    label,
    caption,
}

// Text with one of the DESIGN.md roles: family, size, weight and box height are fixed by the role.
export component Txt inherits Text {
    in property <TextRole> role: TextRole.body;
    font-family: role == TextRole.display ? "Inter Display" : "Inter";
    font-size: role == TextRole.display ? 26px : role == TextRole.title-2 ? 20px : role == TextRole.title-3 ? 17px : role == TextRole.popover-title ? 15px : (role == TextRole.label || role == TextRole.caption) ? 11px : (role == TextRole.callout || role == TextRole.callout-medium) ? 12px : 13px;
    font-weight: role == TextRole.display ? 700 : (role == TextRole.title-3 || role == TextRole.popover-title || role == TextRole.headline || role == TextRole.label) ? 600 : (role == TextRole.title-2 || role == TextRole.body-medium || role == TextRole.callout-medium || role == TextRole.caption) ? 500 : 400;
    height: role == TextRole.display ? 32px : role == TextRole.title-2 ? 26px : role == TextRole.title-3 ? 22px : role == TextRole.popover-title ? 20px : (role == TextRole.label || role == TextRole.caption) ? 14px : 16px;
    color: Tokens.text-primary;
    vertical-alignment: center;
    overflow: elide;
}

export component Icon inherits Image {
    image-fit: contain;
}

export component IconButton inherits Rectangle {
    out property <bool> has-hover: touch.has-hover;
    in property <image> icon;
    in property <length> icon-size: 16px;
    in property <color> icon-color: Tokens.text-primary;
    in property <string> label;
    callback clicked();
    border-width: keyboard.has-focus ? 2px : 0px;
    border-color: Tokens.focus-ring;
    keyboard := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.clicked(); return accept;
            }
            return reject;
        }
    }
    border-radius: 6px;
    background: touch.pressed ? Tokens.fill-icon-pressed : touch.has-hover ? Tokens.fill-icon-hover : transparent;
    animate background { duration: 120ms; easing: ease-out-quint; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    Icon {
        source: root.icon;
        colorize: root.icon-color;
        width: root.icon-size;
        height: root.icon-size;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component SidebarItem inherits Rectangle {
    in property <image> icon;
    // A small cover (playlists) replaces the icon when set.
    in property <image> artwork;
    in property <string> label;
    in property <bool> is-selected;
    callback clicked();
    border-width: keyboard.has-focus ? 2px : 0px;
    border-color: Tokens.focus-ring;
    keyboard := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.clicked(); return accept;
            }
            return reject;
        }
    }
    x: 10px;
    width: 220px;
    height: 28px;
    border-radius: 6px;
    background: root.is-selected ? Tokens.fill-sidebar-selected : (touch.has-hover || touch.pressed) ? Tokens.fill-sidebar-hover : transparent;
    animate background { duration: 120ms; easing: ease-out-quint; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    if root.artwork.width == 0: Icon {
        x: 10px;
        y: 6px;
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize: Tokens.accent;
    }

    if root.artwork.width > 0: Rectangle {
        x: 9px;
        y: 5px;
        width: 18px;
        height: 18px;
        border-radius: 3px;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.artwork;
            image-fit: cover;
        }
    }

    Txt {
        x: 34px;
        y: 0px;
        width: 176px;
        height: 28px;
        text: root.label;
        overflow: elide;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component SidebarHeader inherits Txt {
    x: 20px;
    width: 200px;
    height: 24px;
    role: TextRole.label;
    color: Tokens.text-secondary;
}

export component SearchField inherits Rectangle {
    width: 216px;
    height: 28px;
    border-radius: 7px;
    background: Tokens.surface-field;
    border-width: input.has-focus ? 2px : 0px;
    border-color: Tokens.focus-ring;
    // Cmd/Ctrl+F: focus the field with its text selected, ready to type over.
    public function focus-search() {
        input.focus();
        input.select-all();
    }
    Icon {
        x: 9px;
        y: 7px;
        width: 14px;
        height: 14px;
        source: Icons.magnifying-glass;
        colorize: Tokens.text-secondary;
    }

    Txt {
        x: 30px;
        width: 178px;
        height: 28px;
        text: "Rechercher";
        color: Tokens.text-secondary;
        visible: input.text == "";
    }

    input := TextInput {
        x: 30px;
        width: 178px;
        height: 28px;
        single-line: true;
        vertical-alignment: center;
        font-family: "Inter";
        font-size: 13px;
        color: Tokens.text-primary;
        selection-background-color: Tokens.accent.with-alpha(0.35);
        selection-foreground-color: Tokens.text-primary;
        accessible-label: "Rechercher";
        // Two-way: a route that changes the query (Back, "Aller à l'artiste") updates the field.
        text <=> AppState.query;
        edited => {
            AppState.search-changed(self.text);
        }
    }
}

export enum BadgeKind {
    bit-perfect,
    processed,
    shared,
    unknown,
    authentic,
    doubtful,
}

export component Badge inherits Rectangle {
    in property <BadgeKind> kind: BadgeKind.authentic;
    in property <string> label;
    in property <bool> is-hovered;
    // The LCD shows the icon alone (the text appears on hover); idle = no stream open.
    in property <bool> is-icon-only;
    in property <bool> is-idle;
    property <bool> is-ok: kind == BadgeKind.bit-perfect || kind == BadgeKind.authentic;
    property <color> foreground: (kind == BadgeKind.processed || kind == BadgeKind.shared || kind == BadgeKind.unknown) ? Tokens.text-primary : is-ok ? Tokens.status-ok : Tokens.status-caution;
    width: root.is-icon-only ? 30px : row.preferred-width;
    height: 20px;
    border-radius: 10px;
    background: (kind == BadgeKind.processed || kind == BadgeKind.shared || kind == BadgeKind.unknown) ? Tokens.fill-control : is-ok ? Tokens.status-ok-tint : Tokens.status-caution-tint;
    border-width: root.is-hovered ? 1px : 0px;
    border-color: root.foreground;
    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        alignment: center;
        Icon {
            width: root.is-icon-only ? 14px : 12px;
            source: root.is-idle ? Icons.speaker-hifi : root.kind == BadgeKind.shared ? Icons.intersect : root.kind == BadgeKind.unknown ? Icons.waveform : root.kind == BadgeKind.processed ? Icons.sliders-horizontal : root.kind == BadgeKind.doubtful ? Icons.warning-fill : Icons.seal-check-fill;
            colorize: root.is-idle ? Tokens.text-tertiary : root.foreground;
        }

        if !root.is-icon-only: Txt {
            role: TextRole.label;
            height: root.height;
            text: root.label;
            overflow: elide;
            color: root.foreground;
        }
    }
}

export component PillButton inherits Rectangle {
    in property <bool> is-primary;
    in property <image> icon;
    in property <string> label;
    callback clicked();
    border-width: keyboard.has-focus ? 2px : 0px;
    border-color: Tokens.focus-ring;
    keyboard := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.clicked(); return accept;
            }
            return reject;
        }
    }
    width: 112px;
    height: 32px;
    border-radius: 16px;
    background: root.is-primary ? (touch.pressed ? Tokens.accent-pressed : touch.has-hover ? Tokens.accent-hover : Tokens.accent) : (touch.pressed ? Tokens.fill-icon-pressed : touch.has-hover ? Tokens.fill-control-hover : Tokens.fill-control);
    animate background { duration: 120ms; easing: ease-out-quint; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        // No icon, no reserved slot: the label stays centered.
        if root.icon.width > 0: Icon {
            width: 14px;
            source: root.icon;
            colorize: root.is-primary ? Tokens.text-on-accent : Tokens.accent;
        }

        Txt {
            role: TextRole.headline;
            height: root.height;
            text: root.label;
            color: root.is-primary ? Tokens.text-on-accent : Tokens.accent;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The one control style of page headers (sort menu, "+", "Favoris" filter): a 28 px pill on
// the control fill, brass when a filter is on. Icon only when there is no label.
export component HeaderButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> accessible-name: root.label;
    in property <bool> is-active;
    in property <bool> has-menu-caret;
    callback clicked();
    height: 28px;
    width: root.label == "" ? 28px : content.preferred-width;
    border-radius: 14px;
    background: root.is-active ? Tokens.accent.with-alpha(0.16) : touch.pressed ? Tokens.fill-icon-pressed : touch.has-hover ? Tokens.fill-control-hover : Tokens.fill-control;
    animate background { duration: 120ms; easing: ease-out-quint; }
    border-width: keyboard.has-focus ? 2px : 0px;
    border-color: Tokens.focus-ring;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-action-default => {
        root.clicked();
    }
    keyboard := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.clicked(); return accept;
            }
            return reject;
        }
    }
    content := HorizontalLayout {
        padding-left: root.label == "" ? 0px : 12px;
        padding-right: root.label == "" ? 0px : root.has-menu-caret ? 10px : 12px;
        spacing: 6px;
        alignment: center;
        if root.icon.width > 0: Icon {
            width: root.label == "" ? 14px : 12px;
            source: root.icon;
            colorize: root.is-active ? Tokens.accent : Tokens.text-secondary;
        }
        if root.label != "": Txt {
            role: TextRole.callout-medium;
            height: root.height;
            text: root.label;
            color: root.is-active ? Tokens.accent : Tokens.text-primary;
        }
        if root.has-menu-caret: Icon {
            width: 10px;
            source: Icons.caret-left;
            colorize: Tokens.text-secondary;
            transform-rotation: -90deg;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Square artwork with the level-1 shadow (artwork corners stay square by design decision).
export component Artwork inherits Rectangle {
    in property <image> source;
    background: Tokens.surface-field;
    drop-shadow-offset-y: 2px;
    drop-shadow-blur: 8px;
    drop-shadow-color: Tokens.shadow-artwork;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: fill;
    }
}

export component SignalPath inherits Rectangle {
    in property <[PathStep]> steps;
    height: 160px;
    for step[index] in root.steps: Rectangle {
        x: 0px;
        y: index * 32px;
        width: root.width;
        height: 32px;
        if index < 4: Rectangle {
            x: 7px;
            y: 20px;
            width: 2px;
            height: 24px;
            background: Tokens.separator;
        }
        Rectangle {
            x: 4px;
            y: 12px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: step.value == "Aucune lecture" ? Tokens.text-tertiary : step.is-transparent ? Tokens.status-ok : Tokens.status-caution;
        }

        Txt {
            x: 24px;
            y: 8px;
            width: 72px;
            text: step.label;
            color: Tokens.text-secondary;
        }

        Txt {
            role: TextRole.body-medium;
            x: 104px;
            y: 8px;
            width: root.width - 104px;
            text: step.value;
        }
    }
}

export component EqualizerBars inherits Rectangle {
    width: 24px;
    height: 16px;
    // Idle heights while paused; while playing each bar follows a sine with its own
    // angular speed (rad/s) and phase, driven by the animation clock. The clock is only
    // read while playing, so a paused window does not redraw continuously.
    property <[float]> idle-levels: [0.3, 0.6, 0.4];
    property <[float]> angular-speeds: [7.0, 9.0, 6.0];
    property <[float]> phases: [0.0, 1.0, 2.0];
    for idle-level[index] in root.idle-levels: Rectangle {
        property <float> level: AppState.is-playing
            ? 0.5 + 0.5 * Math.sin((animation-tick() / 1s * root.angular-speeds[index] + root.phases[index]) * 1rad)
            : idle-level;
        x: 11px + index * 5px;
        width: 3px;
        height: Math.round(3 + 9 * self.level) * 1px;
        y: 14px - self.height;
        border-radius: 1px;
        background: Tokens.accent;
    }
}

component MenuRow inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> is-destructive;
    callback clicked();
    height: 32px;
    border-radius: 6px;
    background: touch.has-hover ? Tokens.fill-row-hover : transparent;
    animate background { duration: 120ms; easing: ease-out-quint; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Icon { width: 15px; source: root.icon; colorize: root.is-destructive ? Tokens.status-caution : Tokens.accent; }
        Txt {
            height: root.height;
            text: root.label;
            vertical-alignment: center;
            color: root.is-destructive ? Tokens.status-caution : Tokens.text-primary;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// "…" button with the actions available on any track, album or playlist: play next, add to the
// queue, add to a playlist and, inside a playlist, remove. The menu opens under the button.
export component ActionMenuButton inherits Rectangle {
    out property <bool> has-hover: button.has-hover;
    in property <string> label: "Plus d’actions";
    in property <bool> can-remove;
    // Track menus offer the favorite toggle; album and playlist menus do not.
    in property <bool> can-favorite;
    in property <bool> is-favorite;
    // "Aller à l’album" makes no sense inside that album's own page.
    in property <bool> can-go-to-album;
    in property <color> icon-color: Tokens.text-secondary;
    callback action(TrackAction);
    width: 28px;
    height: 28px;
    // Where the menu opens, in this button's coordinates: under it, or at the pointer.
    property <length> menu-x;
    property <length> menu-y;
    // Opens the menu at (x, y) in this button's coordinates (right click on the row).
    public function open-at(x: length, y: length) {
        root.menu-x = x;
        root.menu-y = y;
        menu.show();
    }
    button := IconButton {
        width: root.width;
        height: root.height;
        icon: Icons.dots-three;
        icon-size: 18px;
        icon-color: root.icon-color;
        label: root.label;
        clicked => { root.open-at(root.width - 232px, root.height + 4px); }
    }
    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 232px;
        Rectangle {
            border-radius: 10px;
            background: Tokens.surface-raised;
            border-width: 1px;
            border-color: Tokens.border-raised;
            drop-shadow-offset-y: 8px;
            drop-shadow-blur: 24px;
            drop-shadow-color: Tokens.shadow-popover;
            VerticalLayout {
                padding: 5px;
                MenuRow { icon: Icons.skip-forward-fill; label: "Lire ensuite"; clicked => { root.action(TrackAction.play-next); } }
                MenuRow { icon: Icons.queue; label: "Ajouter à la file d’attente"; clicked => { root.action(TrackAction.add-to-queue); } }
                MenuRow { icon: Icons.plus; label: "Ajouter à une playlist…"; clicked => { root.action(TrackAction.add-to-playlist); } }
                if root.can-favorite: MenuRow {
                    icon: root.is-favorite ? Icons.heart-fill : Icons.heart;
                    label: root.is-favorite ? "Retirer des favoris" : "Ajouter aux favoris";
                    clicked => { root.action(TrackAction.toggle-favorite); }
                }
                if root.can-go-to-album: MenuRow {
                    icon: Icons.vinyl-record; label: "Aller à l’album";
                    clicked => { root.action(TrackAction.go-to-album); }
                }
                if root.can-favorite: MenuRow {
                    icon: Icons.microphone-stage; label: "Aller à l’artiste";
                    clicked => { root.action(TrackAction.go-to-artist); }
                }
                MenuRow { icon: Icons.magnifying-glass; label: AppState.reveal-label; clicked => { root.action(TrackAction.reveal-in-file-manager); } }
                if root.can-remove: MenuRow {
                    icon: Icons.x; label: "Retirer de la playlist"; is-destructive: true;
                    clicked => { root.action(TrackAction.remove-from-playlist); }
                }
            }
        }
    }
}

// Secondary text that opens a page (artist, album): only the text itself is clickable, so the
// rest of its cell keeps the row's own behavior. It brightens while hovered.
export component TextLink inherits Rectangle {
    in property <string> text;
    // The widest the link may be (its column); shorter text keeps the rest of it unclickable.
    in property <length> available-width;
    in property <TextRole> role: TextRole.body;
    in property <color> text-color: Tokens.text-secondary;
    in property <color> hover-text-color: Tokens.text-primary;
    out property <bool> has-hover: touch.has-hover;
    callback clicked();
    width: min(label.preferred-width, root.available-width);
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    label := Txt {
        role: root.role;
        width: root.width;
        height: root.height;
        vertical-alignment: center;
        text: root.text;
        overflow: elide;
        color: touch.has-hover ? root.hover-text-color : root.text-color;
    }
    touch := TouchArea {
        enabled: root.text != "";
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// With "Lire d'un simple clic", the second press of a double click must not start a track again
// (in the queue the panel is rebuilt in between, so it would even hit another row). A global,
// so a row recreated between the two presses still sees the first one.
export global SingleClickGuard {
    // When a row last played on a single click, on the animation clock.
    property <duration> last-activation-time: -10s;
    // True when this press comes too soon after the previous single-click play; records it
    // otherwise. 400 ms: the usual double-click interval (500 ms on macOS) minus a margin.
    public function is-double-click-repeat() -> bool {
        if animation-tick() - self.last-activation-time < 400ms {
            return true;
        }
        self.last-activation-time = animation-tick();
        return false;
    }
}

// The press rules shared by every track row. Ctrl/Cmd+click toggles the row in the selection,
// Shift+click selects the range, a plain click plays ("Lire d'un simple clic") or selects (then a
// double click plays), a right click opens the row's "…" menu at the pointer. Slint reports
// Command as `control` on macOS.
component TrackRowTouch inherits TouchArea {
    callback activated();
    callback selected(bool /* is-toggle */, bool /* is-range */);
    callback menu-requested(length, length);
    pointer-event(event) => {
        if event.kind != PointerEventKind.up || !self.has-hover {
            return;
        }
        if event.button == PointerEventButton.right {
            root.menu-requested(self.mouse-x, self.mouse-y);
        } else if event.button == PointerEventButton.left {
            if event.modifiers.control || event.modifiers.shift {
                root.selected(event.modifiers.control, event.modifiers.shift);
            } else if AppState.is-single-click-play {
                if !SingleClickGuard.is-double-click-repeat() { root.activated(); }
            } else {
                root.selected(false, false);
            }
        }
    }
    double-clicked => {
        if !AppState.is-single-click-play {
            root.activated();
        }
    }
}

export component TrackRow inherits Rectangle {
    in property <int> number;
    in property <string> title;
    in property <string> format-label;
    in property <string> duration-label;
    in property <bool> is-odd;
    in property <bool> is-current;
    // "…" menu at the end of the row, shown while hovered. Its slot is always reserved so the
    // columns never move.
    in property <bool> has-menu: true;
    in property <bool> can-remove;
    in property <bool> is-favorite;
    in property <bool> can-go-to-album: true;
    in property <string> subtitle;
    in property <bool> is-selected;
    // Plays the track: double click, Return, or a single click with "Lire d'un simple clic".
    callback activated();
    // A press that changes the selection: (is-toggle, is-range); both false = only this row.
    callback selected(bool, bool);
    callback action(TrackAction);
    border-width: keyboard.has-focus ? 2px : 0px;
    border-color: Tokens.focus-ring;
    keyboard := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.activated(); return accept;
            }
            return reject;
        }
    }
    height: 36px;
    border-radius: 6px;
    // Still hovered while the pointer is on the row's own "…" button.
    property <bool> is-hovered: touch.has-hover || menu-button.has-hover;
    background: touch.pressed ? Tokens.fill-row-pressed : root.is-selected ? Tokens.fill-row-selected : root.is-hovered ? Tokens.fill-row-hover : is-odd ? Tokens.fill-row-zebra : transparent;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => {
        root.activated();
    }
    property <length> action-slot: 32px;
    property <length> duration-x: root.width - 12px - root.action-slot - 44px;
    // Wide enough for "24 bits / 192 kHz" in the caption role.
    property <length> format-width: 104px;
    property <length> format-x: duration-x - 16px - root.format-width;
    if !root.is-current: Txt {
        x: 12px;
        y: 10px;
        width: 24px;
        text: root.number;
        horizontal-alignment: right;
        color: Tokens.text-secondary;
    }
    if root.is-current: EqualizerBars {
        x: 12px;
        y: 10px;
    }
    Txt {
        role: root.is-current ? TextRole.body-medium : TextRole.body;
        x: 52px;
        y: root.subtitle == "" ? 10px : 3px;
        width: root.format-x - 16px - 52px;
        text: root.title;
        overflow: elide;
    }

    if root.subtitle != "": Txt {
        role: TextRole.caption;
        x: 52px;
        y: 19px;
        width: root.format-x - 16px - 52px;
        text: root.subtitle;
        color: Tokens.text-secondary;
        overflow: elide;
    }

    Txt {
        role: TextRole.caption;
        x: root.format-x;
        y: 10px;
        width: root.format-width;
        text: root.format-label;
        horizontal-alignment: right;
        color: Tokens.text-secondary;
    }

    Txt {
        x: root.duration-x;
        y: 10px;
        width: 44px;
        text: root.duration-label;
        horizontal-alignment: right;
        color: Tokens.text-secondary;
    }

    touch := TrackRowTouch {
        activated => { root.activated(); }
        selected(is-toggle, is-range) => { root.selected(is-toggle, is-range); }
        menu-requested(x, y) => { menu-button.open-at(x - menu-button.x, y - menu-button.y); }
    }

    // A favorite shows a small heart in the menu slot while the row is not hovered.
    if root.is-favorite && !root.is-hovered: Icon {
        x: root.width - 8px - 28px + 8px;
        y: (root.height - 12px) / 2;
        width: 12px;
        height: 12px;
        source: Icons.heart-fill;
        colorize: Tokens.accent;
    }
    menu-button := ActionMenuButton {
        x: root.width - 8px - 28px;
        y: 4px;
        label: "Actions pour " + root.title;
        can-remove: root.can-remove;
        can-favorite: true;
        is-favorite: root.is-favorite;
        can-go-to-album: root.can-go-to-album;
        opacity: root.has-menu && root.is-hovered ? 1 : 0;
        action(kind) => { root.action(kind); }
    }
}

// Every keyboard and mouse shortcut, for Réglages and the "?" help sheet.
export component ShortcutList inherits VerticalLayout {
    spacing: 6px;
    for shortcut in [
        { keys: "Espace", action: "Lecture / pause" },
        { keys: AppState.shortcut-modifier + "→  /  " + AppState.shortcut-modifier + "←", action: "Morceau suivant / précédent" },
        { keys: AppState.shortcut-modifier + "↑  /  " + AppState.shortcut-modifier + "↓", action: "Volume +1 dB / −1 dB (mode partagé, aussi la molette)" },
        { keys: AppState.shortcut-modifier + "F", action: "Rechercher" },
        { keys: AppState.shortcut-modifier + "L", action: "Morceau en cours" },
        { keys: AppState.shortcut-modifier + "1 à " + AppState.shortcut-modifier + "4", action: "Ajouts récents, Artistes, Albums, Morceaux" },
        { keys: AppState.shortcut-modifier + ",", action: "Réglages" },
        { keys: AppState.shortcut-modifier + "[  /  " + AppState.shortcut-modifier + "]", action: "Page précédente / suivante (souris : boutons 4 et 5)" },
        { keys: AppState.shortcut-modifier + "O  /  " + AppState.shortcut-modifier + "⇧O", action: "Ajouter des fichiers / un dossier" },
        { keys: AppState.shortcut-modifier + "clic  /  ⇧clic", action: "Sélectionner plusieurs morceaux" },
        { keys: "Clic droit", action: "Menu d’un morceau" },
        { keys: AppState.shortcut-modifier + "Z  /  " + AppState.shortcut-modifier + "⇧Z", action: "Annuler / rétablir la dernière modification de la file" },
        { keys: "?  /  F1", action: "Cette aide" },
        { keys: "Échap", action: "Fermer, effacer la sélection, revenir en arrière" },
    ]: HorizontalLayout {
        spacing: 16px;
        Txt { width: 160px; text: shortcut.keys; color: Tokens.text-primary; }
        Txt { text: shortcut.action; color: Tokens.text-secondary; }
    }
}

// Floating bar over the content while several tracks are selected: the "…" actions for all of
// them at once. Static (no animation, one shadow drawn once).
export component SelectionBar inherits Rectangle {
    height: 44px;
    width: content.preferred-width;
    border-radius: 22px;
    background: Tokens.surface-raised;
    border-width: 1px;
    border-color: Tokens.border-raised;
    drop-shadow-offset-y: 6px;
    drop-shadow-blur: 18px;
    drop-shadow-color: Tokens.shadow-popover;
    content := HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 8px;
        alignment: center;
        Txt {
            role: TextRole.callout-medium;
            height: root.height;
            vertical-alignment: center;
            text: AppState.selection-count + " morceaux sélectionnés";
        }
        Rectangle { width: 4px; }
        HeaderButton { y: 8px; icon: Icons.skip-forward-fill; label: "Lire ensuite"; clicked => { AppState.selection-action(TrackAction.play-next); } }
        HeaderButton { y: 8px; icon: Icons.queue; label: "Ajouter à la file"; clicked => { AppState.selection-action(TrackAction.add-to-queue); } }
        HeaderButton { y: 8px; icon: Icons.plus; label: "Playlist…"; clicked => { AppState.selection-action(TrackAction.add-to-playlist); } }
        HeaderButton { y: 8px; icon: Icons.heart; label: "Favoris"; clicked => { AppState.selection-action(TrackAction.toggle-favorite); } }
        if AppState.can-remove-selection: HeaderButton {
            y: 8px; icon: Icons.x; label: "Retirer";
            clicked => { AppState.selection-action(TrackAction.remove-from-playlist); }
        }
        IconButton {
            y: 8px; width: 28px; height: 28px;
            icon: Icons.x; icon-size: 12px; icon-color: Tokens.text-secondary;
            label: "Effacer la sélection (Échap)";
            clicked => { AppState.clear-selection(); }
        }
    }
}

// Shared-mode volume in dB. Exclusive mode greys it out: the DAC sets the level and the
// samples stay bit-perfect. The value appears in a small bubble while hovering or dragging.
export component VolumeSlider inherits Rectangle {
    width: 88px;
    height: 28px;
    property <bool> is-adjustable: !AppState.exclusive || AppState.is-shared;
    property <float> position: AppState.is-volume-muted ? 0 : 1 + AppState.volume-decibels / 60;
    property <length> thumb-center: 88px * root.position;
    accessible-role: slider;
    accessible-label: root.is-adjustable ? "Volume" : "Volume réglé sur le DAC (mode exclusif)";
    accessible-value: AppState.volume-label;
    accessible-value-minimum: 0;
    accessible-value-maximum: 1;
    // Half-decibel steps; the far left mutes.
    function apply(x: length) {
        if !root.is-adjustable {
            return;
        }
        if x <= 2px {
            AppState.volume-changed(AppState.volume-decibels, true);
        } else {
            AppState.volume-changed(Math.round((Math.clamp(x / 88px, 0, 1) - 1) * 60 * 2) / 2, false);
        }
    }
    Rectangle {
        y: 12.5px;
        height: 3px;
        border-radius: 1.5px;
        background: Tokens.rail;
        opacity: root.is-adjustable ? 1 : 0.4;
    }

    Rectangle {
        y: 12.5px;
        width: root.thumb-center;
        height: 3px;
        border-radius: 1.5px;
        background: Tokens.rail-fill;
        opacity: root.is-adjustable ? 1 : 0.4;
    }

    Rectangle {
        x: Math.clamp(root.thumb-center - 5.5px, 0px, 77px);
        y: 8.5px;
        width: 11px;
        height: 11px;
        border-radius: 5.5px;
        background: root.is-adjustable ? Tokens.scrubber-thumb : Tokens.rail;
    }

    touch := TouchArea {
        mouse-cursor: root.is-adjustable ? MouseCursor.pointer : MouseCursor.not-allowed;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.apply(self.mouse-x);
            }
        }
        moved => {
            if self.pressed {
                root.apply(self.mouse-x);
            }
        }
        // The wheel moves one decibel per notch (up = louder), like Cmd/Ctrl+Up/Down.
        scroll-event(event) => {
            if !root.is-adjustable || event.delta-y == 0 {
                return reject;
            }
            AppState.volume-changed(Math.clamp(AppState.volume-decibels + (event.delta-y > 0 ? 1 : -1), -60, 0), false);
            return accept;
        }
    }

    if touch.has-hover || touch.pressed: Rectangle {
        property <length> bubble-width: 96px;
        x: (root.width - self.bubble-width) / 2;
        y: 30px;
        width: self.bubble-width;
        height: 20px;
        border-radius: 10px;
        background: Tokens.surface-raised;
        border-width: 1px;
        border-color: Tokens.border-raised;
        Txt {
            role: TextRole.caption;
            text: root.is-adjustable ? AppState.volume-label : "Réglé sur le DAC";
            color: Tokens.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component Lcd inherits Rectangle {
    // A click anywhere on the cassette (artwork, title, time) except the seek band and the
    // badge asks to unfold it into the current-track page.
    callback open-requested();
    // Fixed slot for the badge: the title and the progress rail never move when the badge text
    // changes ("Sortie libérée", "Mode partagé · 24 bits / 48 kHz"…). The badge is right-aligned
    // in it and its text is elided if ever too long.
    property <length> badge-slot-width: 46px;
    property <length> column-width: root.width - 68px - root.badge-slot-width;
    // Presses below this line seek; above it, a click unfolds the cassette.
    property <length> seek-band-top: 34px;
    property <bool> is-seeking;
    property <bool> are-extras-visible: touch.has-hover || title-keyboard.has-focus || badge-touch.has-hover || root.is-seeking;
    height: 44px;
    border-radius: 6px;
    background: Tokens.surface-lcd;
    border-width: 1px;
    border-color: Tokens.border-lcd;
    function seek-to(x: length) {
        AppState.seek(Math.clamp((x - 48px) / root.column-width, 0, 1));
    }
    touch := TouchArea {
        mouse-cursor: AppState.has-current-track && self.mouse-y < root.seek-band-top ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left && self.mouse-y >= root.seek-band-top {
                root.is-seeking = true;
            } else if event.kind == PointerEventKind.up {
                if root.is-seeking {
                    root.seek-to(self.mouse-x);
                } else if event.button == PointerEventButton.left && AppState.has-current-track && self.has-hover && self.mouse-y < root.seek-band-top {
                    root.open-requested();
                }
                root.is-seeking = false;
            } else if event.kind == PointerEventKind.cancel {
                root.is-seeking = false;
            }
        }
    }

    Rectangle {
        x: 4px;
        y: 4px;
        width: 36px;
        height: 36px;
        border-radius: 4px;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: AppState.lcd-artwork;
            image-fit: fill;
        }
    }

    Txt {
        role: TextRole.body-medium;
        x: 48px;
        y: 6px;
        width: root.column-width;
        text: AppState.lcd-title;
        horizontal-alignment: center;
    }

    Txt {
        role: TextRole.callout;
        x: 88px;
        y: 22px;
        width: root.column-width - 80px;
        text: AppState.lcd-subtitle;
        horizontal-alignment: center;
        color: Tokens.text-secondary;
    }

    // Declared before the extras so the scrubber thumb is drawn on top of the rail.
    Rectangle {
        x: 48px;
        y: 39px;
        width: root.column-width;
        height: 3px;
        border-radius: 1.5px;
        background: Tokens.rail;
        Rectangle {
            x: 0px;
            width: parent.width * AppState.progress;
            border-radius: 1.5px;
            background: Tokens.rail-fill;
        }
    }

    Rectangle {
        opacity: root.are-extras-visible ? 1 : 0;
        animate opacity { duration: 120ms; easing: ease-out-quint; }
        Txt {
            role: TextRole.caption;
            x: 48px;
            y: 22px;
            width: 40px;
            text: AppState.elapsed-label;
            color: Tokens.text-secondary;
        }

        Txt {
            role: TextRole.caption;
            x: 48px + root.column-width - 40px;
            y: 22px;
            width: 40px;
            text: AppState.remaining-label;
            horizontal-alignment: right;
            color: Tokens.text-secondary;
        }

        Rectangle {
            x: 48px + root.column-width * AppState.progress - 4.5px;
            y: 36px;
            width: 9px;
            height: 9px;
            border-radius: 4.5px;
            background: Tokens.scrubber-thumb;
        }
    }

    Rectangle {
        x: 48px; y: 4px; width: root.column-width; height: 28px;
        accessible-role: button;
        accessible-label: "Afficher le morceau en cours : " + AppState.lcd-title;
        accessible-action-default => { root.open-requested(); }
        border-width: title-keyboard.has-focus ? 2px : 0px;
        border-color: Tokens.focus-ring;
        title-keyboard := FocusScope {
            enabled: AppState.has-current-track;
            key-pressed(event) => {
                if event.text == Key.Return || event.text == " " {
                    root.open-requested(); return accept;
                }
                return reject;
            }
        }
    }

    badge := Badge {
        x: root.width - 8px - self.width;
        y: 12px;
        is-icon-only: true;
        is-idle: !AppState.is-output-active;
        kind: AppState.is-bit-perfect ? BadgeKind.bit-perfect : AppState.is-shared ? BadgeKind.shared : BadgeKind.unknown;
        label: AppState.badge-label;
        is-hovered: badge-touch.has-hover;
        accessible-role: button;
        accessible-label: AppState.badge-label;
        accessible-action-default => {
            AppState.is-popover-open = !AppState.is-popover-open;
        }
        badge-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                AppState.is-popover-open = !AppState.is-popover-open;
            }
        }
    }

    // The full mode and format while hovering the badge; a click opens the signal panel.
    if badge-touch.has-hover && !AppState.is-popover-open: Rectangle {
        property <length> bubble-width: hint.preferred-width + 20px;
        x: root.width - 8px - self.bubble-width;
        y: root.height + 6px;
        width: self.bubble-width;
        height: 24px;
        border-radius: 12px;
        background: Tokens.surface-raised;
        border-width: 1px;
        border-color: Tokens.border-raised;
        drop-shadow-offset-y: 4px;
        drop-shadow-blur: 12px;
        drop-shadow-color: Tokens.shadow-popover;
        hint := Txt {
            role: TextRole.label;
            text: AppState.badge-label;
            color: AppState.is-bit-perfect ? Tokens.status-ok : Tokens.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component Popover inherits Rectangle {
    width: 380px;
    height: body.preferred-height;
    border-radius: 10px;
    background: Tokens.surface-raised;
    border-width: 1px;
    border-color: Tokens.border-raised;
    drop-shadow-offset-y: 8px;
    drop-shadow-blur: 24px;
    drop-shadow-color: Tokens.shadow-popover;
    // Swallows clicks so that only clicks outside close the popover.
    TouchArea { }

    body := VerticalLayout {
        padding: 16px;
        HorizontalLayout {
            height: 20px;
            spacing: 8px;
            Icon {
                width: 18px;
                source: AppState.is-bit-perfect ? Icons.seal-check-fill : AppState.is-shared ? Icons.intersect : Icons.waveform;
                colorize: AppState.is-bit-perfect ? Tokens.status-ok : Tokens.text-secondary;
            }

            Txt {
                role: TextRole.popover-title;
                text: AppState.signal-title;
            }
        }

        Rectangle {
            height: 6px;
        }

        Text {
            text: AppState.signal-description;
            font-family: "Inter";
            font-size: 12px;
            wrap: word-wrap;
            line-height-factor: 1.171;
            vertical-alignment: top;
            color: Tokens.text-secondary;
        }

        Rectangle {
            height: 12px;
        }

        Rectangle {
            height: 1px;
            background: Tokens.separator;
        }

        Rectangle {
            height: 12px;
        }

        SignalPath {
            steps: AppState.path-steps;
        }

        Rectangle {
            height: 12px;
        }

        Rectangle {
            height: 1px;
            background: Tokens.separator;
        }

        Rectangle {
            height: 12px;
        }

        Switch {
            text: "Mode exclusif"; checked: AppState.exclusive;
            toggled => { AppState.set-exclusive(self.checked); }
        }
        if AppState.show-exclusive-notice: Text {
            text: "En mode exclusif, les autres sons de ce périphérique sont coupés pendant la lecture.";
            color: Tokens.text-secondary; wrap: word-wrap;
        }
        if AppState.show-exclusive-notice: HorizontalLayout {
            alignment: start;
            PillButton { label: "Compris"; clicked => { AppState.dismiss-notice(); } }
        }
        Text { text: AppState.underrun-label; color: Tokens.text-secondary; }
        Rectangle { height: 8px; }
        HorizontalLayout {
            spacing: 6px;
            Icon { width: 14px; source: AppState.transmission-ok ? Icons.seal-check-fill : Icons.waveform; colorize: AppState.transmission-ok ? Tokens.status-ok : Tokens.text-secondary; }
            Text { text: AppState.transmission-text; color: AppState.transmission-ok ? Tokens.status-ok : Tokens.text-primary; wrap: word-wrap; }
        }
        Text { text: AppState.transmission-digest; color: Tokens.text-secondary; wrap: char-wrap; font-size: 11px; }
        Rectangle { height: 8px; }
        HorizontalLayout {
            spacing: 6px;
            Icon { width: 14px; source: AppState.integrity-ok ? Icons.seal-check-fill : Icons.waveform; colorize: AppState.integrity-ok ? Tokens.status-ok : Tokens.text-secondary; }
            Text { text: AppState.integrity-text; color: AppState.integrity-ok ? Tokens.status-ok : Tokens.text-primary; wrap: word-wrap; }
        }
        Text { text: AppState.integrity-digest; color: Tokens.text-secondary; wrap: char-wrap; font-size: 11px; }

    }
}

component AlbumTile inherits Rectangle {
    in property <AlbumCard> album;
    in property <length> tile;
    callback open();
    callback play();
    property <bool> is-hovered: open-touch.has-hover || play-touch.has-hover || tile-menu.has-hover;
    width: root.tile;
    height: root.tile + 40px;
    border-width: keyboard.has-focus ? 2px : 0px;
    border-color: Tokens.focus-ring;
    keyboard := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.open(); return accept; }
            return reject;
        }
    }
    accessible-role: button;
    accessible-label: root.album.title;
    accessible-action-default => {
        root.open();
    }
    Artwork {
        x: 0px;
        y: 0px;
        width: root.tile;
        height: root.tile;
        source: root.album.artwork;
    }

    Txt {
        role: TextRole.body-medium;
        x: 0px;
        y: root.tile + 8px;
        width: root.tile;
        text: root.album.title;
    }

    Txt {
        x: 0px;
        y: root.tile + 24px;
        width: root.tile;
        text: root.album.artist;
        color: Tokens.text-secondary;
    }

    open-touch := TouchArea {
        clicked => {
            root.open();
        }
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.tile;
        height: root.tile;
        opacity: root.is-hovered ? 1 : 0;
        animate opacity { duration: 120ms; easing: ease-out-quint; }
        background: Tokens.overlay-artwork-hover;
    }

    Rectangle {
        x: 8px;
        y: root.tile - 40px;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        opacity: root.is-hovered ? 1 : 0;
        animate opacity { duration: 120ms; easing: ease-out-quint; }
        background: play-touch.has-hover ? Tokens.overlay-button-hover : Tokens.overlay-button;
        // Optical centering: the triangle's box sits 1 px right of the circle's center so its
        // visual weight is centered (measured on a Retina capture, 2026-10-12).
        Icon {
            x: 9px;
            y: 9px;
            width: 14px;
            height: 14px;
            source: Icons.play-fill;
            colorize: Tokens.overlay-icon;
        }
    }

    play-touch := TouchArea {
        x: 8px;
        y: root.tile - 40px;
        width: 32px;
        height: 32px;
        accessible-role: button;
        accessible-label: "Lire " + root.album.title;
        clicked => {
            root.play();
        }
    }

    tile-menu := ActionMenuButton {
        x: root.tile - 8px - 28px;
        y: root.tile - 36px;
        label: "Actions pour " + root.album.title;
        icon-color: Tokens.overlay-icon;
        opacity: root.is-hovered ? 1 : 0;
        action(kind) => {
            AppState.track-action({ source: TrackSource.album, album: root.album.catalog-index, track: 0, position: 0 }, kind);
        }
    }

}

export component AlbumsGrid inherits Rectangle {
    property <length> inner-width: root.width - 64px;
    property <int> columns: Math.clamp(Math.floor((root.inner-width + 24px) / 184px), 3, 8);
    property <length> tile: Math.floor((root.inner-width - 24px * (root.columns - 1)) / root.columns / 1px) * 1px;
    property <length> pitch: root.tile + 64px;
    property <int> row-count: Math.ceil(AppState.albums.length / root.columns);
    // One artist's albums, not searching: the artist's page (photo, "Tout lire", the albums from
    // the newest, then "Les plus écoutés").
    property <bool> is-artist-page: AppState.artist-filter != "" && AppState.query == "";
    property <length> header-height: root.is-artist-page ? 200px : 88px;
    // While searching (or on an artist's page): a heading plus one row per listed track.
    property <int> search-row-count: (AppState.query != "" || root.is-artist-page) && AppState.search-tracks.length > 0 ? AppState.search-tracks.length + 1 : 0;
    if AppState.artist-filter != "": IconButton {
        x: 26px; y: 26px; width: 28px; height: 28px;
        icon: Icons.caret-left; icon-color: Tokens.accent;
        label: "Retour : " + AppState.back-label;
        clicked => { AppState.navigate-back(); }
    }
    if !root.is-artist-page: Txt {
        role: TextRole.display;
        x: AppState.artist-filter != "" ? 60px : 32px;
        y: 24px;
        width: root.width - 64px - 220px;
        text: AppState.artist-filter != "" ? AppState.artist-filter : "Albums";
        overflow: elide;
    }
    if !root.is-artist-page: Txt {
        x: AppState.artist-filter != "" ? 60px : 32px;
        y: 58px;
        role: TextRole.callout;
        color: Tokens.text-secondary;
        visible: AppState.albums.length > 0;
        text: AppState.albums.length + (AppState.albums.length == 1 ? " album" : " albums");
    }
    if root.is-artist-page: Rectangle {
        x: 60px; y: 24px; width: 148px; height: 148px;
        border-radius: 74px;
        clip: true;
        background: Tokens.surface-field;
        Image { width: parent.width; height: parent.height; source: AppState.artist-page-photo; image-fit: cover; }
    }
    if root.is-artist-page: VerticalLayout {
        x: 236px; y: 24px; width: root.width - 236px - 32px; height: 148px;
        alignment: center;
        spacing: 8px;
        Txt { role: TextRole.label; text: "ARTISTE"; color: Tokens.text-secondary; }
        Txt { role: TextRole.display; text: AppState.artist-filter; overflow: elide; }
        Txt { role: TextRole.callout; text: AppState.artist-page-detail; color: Tokens.text-secondary; }
        Rectangle { height: 6px; }
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            PillButton { label: "Tout lire"; icon: Icons.play-fill; is-primary: true; clicked => { AppState.play-artist(false); } }
            PillButton { label: "Aléatoire"; icon: Icons.shuffle; clicked => { AppState.play-artist(true); } }
        }
    }

    // "Trier par" menu, right-aligned with the grid.
    sort-button := HeaderButton {
        visible: !root.is-artist-page;
        x: root.width - 32px - self.width;
        y: 26px;
        label: "Trier par : " + AppState.album-sort-labels[AppState.album-sort-index];
        accessible-name: "Trier les albums par " + AppState.album-sort-labels[AppState.album-sort-index];
        has-menu-caret: true;
        clicked => { sort-menu.show(); }
    }

    // "+" next to the sort menu: add music once the library is no longer empty.
    add-button := HeaderButton {
        visible: !root.is-artist-page;
        x: sort-button.x - 8px - self.width;
        y: 26px;
        icon: Icons.plus;
        accessible-name: "Ajouter de la musique";
        clicked => { add-menu.show(); }
    }

    add-menu := PopupWindow {
        x: add-button.x + add-button.width - 220px;
        y: 58px;
        width: 220px;
        Rectangle {
            border-radius: 10px;
            background: Tokens.surface-raised;
            border-width: 1px;
            border-color: Tokens.border-raised;
            drop-shadow-offset-y: 8px;
            drop-shadow-blur: 24px;
            drop-shadow-color: Tokens.shadow-popover;
            VerticalLayout {
                padding: 5px;
                MenuRow { icon: Icons.vinyl-record; label: "Ajouter un dossier…"; clicked => { AppState.import-folder(); } }
                MenuRow { icon: Icons.music-note; label: "Ajouter des fichiers…"; clicked => { AppState.import-files(); } }
            }
        }
    }

    sort-menu := PopupWindow {
        x: root.width - 32px - 220px;
        y: 58px;
        width: 220px;
        Rectangle {
            border-radius: 10px;
            background: Tokens.surface-raised;
            border-width: 1px;
            border-color: Tokens.border-raised;
            drop-shadow-offset-y: 8px;
            drop-shadow-blur: 24px;
            drop-shadow-color: Tokens.shadow-popover;
            VerticalLayout {
                padding: 5px;
                for label[index] in AppState.album-sort-labels: MenuRow {
                    icon: index == AppState.album-sort-index ? Icons.check : @image-url("");
                    label: label;
                    clicked => { AppState.set-album-sort(index); }
                }
            }
        }
    }

    ListView {
        y: root.header-height;
        height: root.height - root.header-height;
        content-y <=> AppState.grid-scroll-y;
        // One repeater (a ListView allows only one): album grid rows, then, while searching, a
        // "Morceaux" heading and the matching tracks.
        for item-index in root.row-count + root.search-row-count: Rectangle {
            property <int> track-row: item-index - root.row-count - 1;
            height: item-index < root.row-count ? root.pitch : item-index == root.row-count ? 48px : 36px;
            if item-index < root.row-count: Rectangle {
                for column in root.columns: Rectangle {
                    if item-index * root.columns + column < AppState.albums.length: AlbumTile {
                        x: 32px + column * (root.tile + 24px);
                        tile: root.tile;
                        album: AppState.albums[item-index * root.columns + column];
                        open => {
                            AppState.open-album(self.album.catalog-index);
                        }
                        play => {
                            AppState.play-track(self.album.catalog-index, 0);
                        }
                    }
                }
            }
            if item-index == root.row-count: Txt { x: 32px; y: 14px; role: TextRole.title-3; text: root.is-artist-page ? "Les plus écoutés" : "Morceaux"; }
            if item-index > root.row-count: TrackRow {
                x: 32px;
                width: root.width - 64px;
                number: AppState.search-tracks[parent.track-row].number;
                title: AppState.search-tracks[parent.track-row].title;
                subtitle: AppState.search-tracks[parent.track-row].subtitle;
                format-label: AppState.search-tracks[parent.track-row].format-label;
                duration-label: AppState.search-tracks[parent.track-row].duration-label;
                is-odd: Math.mod(parent.track-row, 2) == 1;
                is-current: AppState.search-tracks[parent.track-row].is-current;
                is-favorite: AppState.search-tracks[parent.track-row].is-favorite;
                is-selected: AppState.search-tracks[parent.track-row].is-selected;
                activated => { AppState.play-search-result(parent.track-row); }
                selected(is-toggle, is-range) => {
                    AppState.select-track({ source: TrackSource.search-result, album: 0, track: 0, position: parent.track-row }, is-toggle, is-range);
                }
                action(kind) => {
                    AppState.track-action({ source: TrackSource.search-result, album: 0, track: 0, position: parent.track-row }, kind);
                }
            }
        }
    }

    if AppState.albums.length == 0 && AppState.query == "": HorizontalLayout {
        x: (root.width - 244px) / 2; y: 272px; width: 244px; height: 32px; spacing: 12px;
        PillButton { is-primary: true; icon: Icons.music-note; label: "Fichiers"; clicked => { AppState.import-files(); } }
        PillButton { icon: Icons.vinyl-record; label: "Dossier"; clicked => { AppState.import-folder(); } }
    }
    if AppState.albums.length == 0 && AppState.search-tracks.length == 0: VerticalLayout {
        y: 88px + 96px;
        height: 80px;
        spacing: 12px;
        alignment: start;
        Icon {
            height: 32px;
            source: Icons.magnifying-glass;
            colorize: Tokens.text-tertiary;
        }

        Txt {
            text: AppState.no-results-text;
            horizontal-alignment: center;
            color: Tokens.text-secondary;
        }
    }
}

component DataCellView inherits Rectangle {
    in property <DataCell> data;
    height: 32px;
    Txt {
        role: TextRole.caption;
        x: 0px;
        y: 0px;
        width: root.width;
        text: root.data.label;
        color: Tokens.text-secondary;
    }

    Txt {
        role: TextRole.body-medium;
        x: 0px;
        y: 16px;
        width: root.width;
        text: root.data.value;
    }
}

export component AlbumDetail inherits Rectangle {
    property <length> content-width: root.width;
    property <length> list-width: root.content-width - 64px;
    property <length> list-end: 328px + 36px * AppState.detail-tracks.length;
    property <length> quality-y: root.list-end + 106px;
    property <length> right-width: root.content-width - 472px;
    property <length> spectrogram-y: 28px + summary.height + 12px;
    property <length> right-height: root.spectrogram-y + 128px + 12px + 120px;
    property <int> cutoff-y: Math.round((1 - AppState.detail.cutoff-fraction) * 128);
    ScrollView {
        content-y <=> AppState.detail-scroll-y;
        content-width: root.content-width;
        content-height: root.quality-y + Math.max(192px, root.right-height) + 40px;
        Rectangle {
            x: 26px;
            y: 16px;
            width: back-row.preferred-width;
            height: 28px;
            border-radius: 6px;
            background: back-touch.pressed ? Tokens.fill-row-pressed : back-touch.has-hover ? Tokens.fill-row-hover : transparent;
            animate background { duration: 120ms; easing: ease-out-quint; }
            accessible-role: button;
            accessible-label: "Retour : " + AppState.back-label;
            accessible-action-default => {
                AppState.navigate-back();
            }
            back-row := HorizontalLayout {
                padding-left: 6px;
                padding-right: 8px;
                spacing: 4px;
                Icon {
                    width: 16px;
                    source: Icons.caret-left;
                    colorize: Tokens.accent;
                }

                Txt {
                    role: TextRole.body-medium;
                    height: 28px;
                    text: AppState.back-label;
                    color: Tokens.accent;
                }
            }

            back-touch := TouchArea {
                clicked => {
                    AppState.navigate-back();
                }
            }
        }

        Artwork {
            x: 32px;
            y: 60px;
            width: 240px;
            height: 240px;
            source: AppState.detail.artwork;
        }

        ActionMenuButton {
            x: root.content-width - 32px - 28px - 8px - 28px;
            y: 60px;
            label: "Actions pour l’album";
            action(kind) => {
                AppState.track-action({ source: TrackSource.album, album: AppState.detail-album-index, track: 0, position: 0 }, kind);
            }
        }

        // Discreet edit button, top-aligned with the cover, at the right edge of the content.
        IconButton {
            x: root.content-width - 32px - 28px;
            y: 60px;
            width: 28px;
            height: 28px;
            icon: Icons.pencil-simple;
            icon-color: Tokens.text-secondary;
            label: "Modifier l’album";
            clicked => {
                AppState.begin-album-edit(AppState.detail-album-index);
            }
        }


        Txt {
            role: TextRole.display;
            x: 300px;
            y: 160px;
            width: root.content-width - 332px;
            text: AppState.detail.title;
        }

        // Each artist of the album opens its page.
        HorizontalLayout {
            x: 300px;
            y: 194px;
            width: root.content-width - 332px;
            height: 28px;
            alignment: start;
            for artist[index] in AppState.detail-artists: HorizontalLayout {
                if index > 0: Txt { role: TextRole.title-2; text: ", "; color: Tokens.accent; }
                TextLink {
                    role: TextRole.title-2;
                    available-width: root.content-width - 332px;
                    text: artist;
                    text-color: Tokens.accent;
                    hover-text-color: Tokens.accent-hover;
                    clicked => { AppState.open-artist-named(artist); }
                }
            }
        }

        HorizontalLayout {
            x: 300px;
            y: 228px;
            width: root.content-width - 332px;
            height: 20px;
            spacing: 8px;
            alignment: start;
            Txt {
                role: TextRole.callout-medium;
                height: 20px;
                text: AppState.detail.meta-line;
                color: Tokens.text-secondary;
            }

            Badge {
                kind: BadgeKind.unknown;
                label: AppState.detail.verdict-label;
            }
        }

        PillButton {
            x: 300px;
            y: 268px;
            is-primary: true;
            icon: Icons.play-fill;
            label: "Lecture";
            clicked => {
                AppState.play-detail-album();
            }
        }

        PillButton {
            x: 424px;
            y: 268px;
            icon: Icons.shuffle;
            label: "Aléatoire";
            clicked => {
                AppState.is-shuffle-on = true;
                AppState.shuffle-detail-album();
            }
        }

        // Where listening to this album stopped; hidden while the album plays.
        if AppState.detail-resume-label != "" && AppState.playing-album-index != AppState.detail-album-index: PillButton {
            x: 548px;
            y: 268px;
            icon: Icons.clock-counter-clockwise;
            label: AppState.detail-resume-label;
            clicked => { AppState.resume-detail-album(); }
        }

        for track[index] in AppState.detail-tracks: Rectangle {
            x: 32px;
            y: 328px + 36px * index;
            width: root.list-width;
            height: 36px;
            if track.is-disc-header: Txt {
                x: 12px;
                y: 14px;
                role: TextRole.headline;
                text: track.title;
                color: Tokens.text-secondary;
            }
            if !track.is-disc-header: TrackRow {
                width: parent.width;
                number: track.number;
                title: track.title;
                format-label: track.format-label;
                duration-label: track.duration-label;
                is-odd: Math.mod(track.track-index, 2) == 1;
                is-current: AppState.playing-album-index == AppState.detail-album-index && AppState.playing-track-index == track.track-index;
                is-favorite: track.is-favorite;
                is-selected: track.is-selected;
                can-go-to-album: false;
                activated => {
                    AppState.play-track(AppState.detail-album-index, track.track-index);
                }
                selected(is-toggle, is-range) => {
                    AppState.select-track({ source: TrackSource.album-track, album: AppState.detail-album-index, track: track.track-index, position: 0 }, is-toggle, is-range);
                }
                action(kind) => {
                    AppState.track-action({ source: TrackSource.album-track, album: AppState.detail-album-index, track: track.track-index, position: 0 }, kind);
                }
            }
        }

        Txt {
            role: TextRole.callout;
            x: 44px;
            y: root.list-end + 12px;
            width: root.list-width - 12px;
            text: AppState.detail.footer-line;
            color: Tokens.text-secondary;
        }

        Txt {
            role: TextRole.title-3;
            x: 32px;
            y: root.list-end + 68px;
            width: root.content-width - 64px;
            text: "Qualité";
        }

        // Left column: signal path of this album on the current output.
        Rectangle {
            x: 32px;
            y: root.quality-y;
            width: 360px;
            height: 192px;
            Txt {
                role: TextRole.headline;
                x: 0px;
                y: 2px;
                width: 240px;
                text: "Chemin du signal";
            }

            Badge {
                y: 0px;
                x: 360px - self.width;
                kind: AppState.detail-is-bit-perfect ? BadgeKind.bit-perfect : BadgeKind.unknown;
                label: AppState.detail-badge-label;
            }

            SignalPath {
                y: 32px;
                width: 360px;
                steps: AppState.detail-path-steps;
            }
        }

        // Right column: authenticity verdict, spectrogram and measurements.
        Rectangle {
            x: 440px;
            y: root.quality-y;
            width: root.right-width;
            height: root.right-height;
            Txt {
                role: TextRole.headline;
                x: 0px;
                y: 2px;
                width: 240px;
                text: "Authenticité";
            }

            Badge {
                y: 0px;
                x: root.right-width - self.width;
                kind: BadgeKind.unknown;
                label: AppState.detail.verdict-label;
            }

            summary := Text {
                x: 0px;
                y: 28px;
                width: root.right-width;
                text: AppState.detail.summary;
                font-family: "Inter";
                font-size: 13px;
                color: Tokens.text-primary;
                wrap: word-wrap;
                vertical-alignment: top;
                line-height-factor: 1.144;
            }

            Rectangle {
                y: root.spectrogram-y;
                width: root.right-width;
                height: 128px;
                border-radius: 6px;
                clip: true;
                background: Tokens.surface-field;
                Text {
                    text: "Aucune analyse spectrale";
                    color: Tokens.text-secondary;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: AppState.detail.spectrogram;
                    image-fit: fill;
                }

                Txt {
                    role: TextRole.caption;
                    x: 8px;
                    y: 6px;
                    width: 120px;
                    text: AppState.detail.nyquist-label;
                    color: Tokens.spectrogram-label;
                }

                Txt {
                    role: TextRole.caption;
                    x: 8px;
                    y: 108px;
                    width: 120px;
                    text: AppState.detail.zero-label;
                    color: Tokens.spectrogram-label;
                }

                if AppState.detail.should-mark-cutoff: Rectangle {
                    y: root.cutoff-y * 1px;
                    height: 1px;
                    background: Tokens.spectrogram-cutoff;
                }
                if AppState.detail.should-mark-cutoff: Txt {
                    role: TextRole.caption;
                    x: root.right-width - 8px - 200px;
                    y: root.cutoff-y * 1px - 16px;
                    width: 200px;
                    text: AppState.detail.cutoff-label;
                    horizontal-alignment: right;
                    color: Tokens.spectrogram-cutoff;
                }
            }

            for data-cell[index] in AppState.detail.cells: DataCellView {
                x: Math.mod(index, 2) * ((root.right-width - 16px) / 2 + 16px);
                y: root.spectrogram-y + 128px + 12px + Math.floor(index / 2) * 44px;
                width: (root.right-width - 16px) / 2;
                data: data-cell;
            }
        }
    }
}

// A grouped list in the style of the system settings: rounded card, hairline separators.
component SettingsCard inherits Rectangle {
    background: Tokens.fill-row-zebra;
    border-radius: 10px;
    border-width: 1px;
    border-color: Tokens.separator;
}

component DeviceRow inherits Rectangle {
    in property <string> name;
    // Secondary text after the name, e.g. the device "Sortie du système" resolves to.
    in property <string> detail;
    in property <bool> is-selected;
    in property <bool> has-separator;
    callback clicked();
    height: 40px;
    border-radius: 8px;
    background: touch.pressed ? Tokens.fill-row-pressed : touch.has-hover ? Tokens.fill-row-hover : transparent;
    animate background { duration: 120ms; easing: ease-out-quint; }
    accessible-role: button;
    accessible-label: root.detail == "" ? root.name : root.name + " · " + root.detail;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Icon { width: 16px; source: Icons.speaker-hifi; colorize: Tokens.text-secondary; }
        HorizontalLayout {
            spacing: 6px;
            Txt { height: root.height; text: root.name; vertical-alignment: center; horizontal-stretch: 0; }
            if root.detail != "": Txt {
                height: root.height;
                text: "· " + root.detail;
                color: Tokens.text-secondary;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        Icon { width: 16px; source: Icons.check; colorize: Tokens.accent; opacity: root.is-selected ? 1 : 0; }
    }
    if root.has-separator: Rectangle {
        x: 38px; y: root.height - 1px; width: root.width - 50px; height: 1px;
        background: Tokens.separator;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component FolderRow inherits Rectangle {
    in property <string> path;
    in property <bool> has-separator;
    callback remove();
    height: 40px;
    border-radius: 8px;
    property <bool> is-hovered: touch.has-hover || remove-button.has-hover;
    background: root.is-hovered ? Tokens.fill-row-hover : transparent;
    touch := TouchArea { }
    Icon { x: 12px; y: 12px; width: 16px; height: 16px; source: Icons.vinyl-record; colorize: Tokens.text-secondary; }
    Txt { x: 38px; width: root.width - 38px - 44px; height: root.height; vertical-alignment: center; text: root.path; overflow: elide; }
    remove-button := IconButton {
        x: root.width - 36px; y: 8px; width: 24px; height: 24px;
        icon: Icons.x; icon-size: 14px; icon-color: Tokens.text-secondary;
        label: "Retirer ce dossier de la bibliothèque";
        opacity: root.is-hovered ? 1 : 0;
        clicked => { root.remove(); }
    }
    if root.has-separator: Rectangle {
        x: 38px; y: root.height - 1px; width: root.width - 50px; height: 1px;
        background: Tokens.separator;
    }
}

export component OutputSettings inherits Rectangle {
    ScrollView {
        content-y <=> AppState.settings-scroll-y;
        VerticalLayout {
            alignment: start;
            spacing: 12px;
            padding-bottom: 24px;
            // Keeps the content clear of the scroll bar on the right.
            padding-right: 20px;
            Txt { role: TextRole.display; text: "Réglages"; }
            Rectangle { height: 4px; }
            HorizontalLayout {
                height: 32px;
                alignment: space-between;
                Txt { role: TextRole.title-3; height: 32px; text: "Sortie audio"; vertical-alignment: center; }
                PillButton {
                    width: 128px;
                    label: "Actualiser";
                    icon: Icons.arrows-clockwise;
                    clicked => { AppState.refresh-devices(); }
                }
            }
            SettingsCard {
                VerticalLayout {
                    padding: 4px;
                    if AppState.device-names.length > 0: DeviceRow {
                        name: "Sortie du système";
                        detail: AppState.system-output-device-name;
                        is-selected: AppState.is-system-output-selected;
                        has-separator: true;
                        clicked => { AppState.select-system-output(); }
                    }
                    for name[index] in AppState.device-names: DeviceRow {
                        name: name;
                        is-selected: !AppState.is-system-output-selected && index == AppState.selected-device-index;
                        has-separator: index < AppState.device-names.length - 1;
                        clicked => { AppState.select-device(index); }
                    }
                    if AppState.device-names.length == 0: Txt {
                        height: 40px;
                        text: "Aucune sortie audio détectée.";
                        color: Tokens.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            SettingsCard {
                HorizontalLayout {
                    padding: 14px;
                    spacing: 16px;
                    VerticalLayout {
                        spacing: 4px;
                        Txt { role: TextRole.headline; text: "Mode exclusif"; }
                        Txt {
                            role: TextRole.callout;
                            text: "Pistolame prend la sortie pour lui seul, à la fréquence du fichier. Les autres sons de ce périphérique sont coupés pendant la lecture.";
                            color: Tokens.text-secondary;
                            wrap: word-wrap;
                            height: self.preferred-height;
                        }
                    }
                    Switch {
                        checked: AppState.exclusive;
                        accessible-label: "Mode exclusif";
                        toggled => { AppState.set-exclusive(self.checked); }
                    }
                }
            }
            Txt { role: TextRole.title-3; text: "Chemin du signal"; height: 34px; vertical-alignment: bottom; }
            SettingsCard {
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    Txt { text: AppState.signal-description; color: Tokens.text-secondary; wrap: word-wrap; height: self.preferred-height; }
                    SignalPath { steps: AppState.path-steps; }
                    Txt { text: AppState.transmission-text; wrap: word-wrap; height: self.preferred-height; }
                    Txt { text: AppState.integrity-text; wrap: word-wrap; height: self.preferred-height; }
                    Txt { role: TextRole.callout; text: AppState.underrun-label; color: Tokens.text-secondary; }
                    Txt { role: TextRole.callout; text: AppState.volume-description; color: Tokens.text-secondary; wrap: word-wrap; height: self.preferred-height; }
                }
            }
            HorizontalLayout {
                alignment: start;
                padding-top: 4px;
                PillButton {
                    width: 168px;
                    label: "Arrêter la lecture";
                    icon: Icons.pause-fill;
                    clicked => { AppState.stop(); }
                }
            }
            Rectangle { height: 12px; }
            HorizontalLayout {
                height: 32px;
                spacing: 10px;
                Txt { role: TextRole.title-3; height: 32px; text: "Bibliothèque"; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                PillButton {
                    width: 128px;
                    label: "Rescanner";
                    icon: Icons.arrows-clockwise;
                    clicked => { AppState.rescan-library(); }
                }
                PillButton {
                    width: 168px;
                    is-primary: true;
                    label: "Ajouter un dossier";
                    icon: Icons.plus;
                    clicked => { AppState.import-folder(); }
                }
            }
            SettingsCard {
                VerticalLayout {
                    padding: 4px;
                    for folder[index] in AppState.library-folders: FolderRow {
                        path: folder;
                        has-separator: index < AppState.library-folders.length - 1;
                        remove => { AppState.remove-library-folder(index); }
                    }
                    if AppState.library-folders.length == 0: Txt {
                        height: 40px;
                        text: "Aucun dossier suivi. Ajoutez le dossier où se trouve votre musique.";
                        color: Tokens.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Txt {
                role: TextRole.callout;
                text: "Retirer un dossier l’enlève de Pistolame ; vos fichiers ne sont jamais supprimés.";
                color: Tokens.text-tertiary;
            }
            SettingsCard {
                HorizontalLayout {
                    padding: 14px;
                    spacing: 16px;
                    VerticalLayout {
                        spacing: 4px;
                        Txt { role: TextRole.headline; text: "Photos d’artistes"; }
                        Txt {
                            role: TextRole.callout;
                            text: "Cherche la photo de chaque artiste sur Deezer. Seuls les noms d’artistes sont envoyés ; les photos sont gardées dans la bibliothèque.";
                            color: Tokens.text-secondary;
                            wrap: word-wrap;
                            height: self.preferred-height;
                        }
                    }
                    Switch {
                        checked: AppState.are-artist-photos-on;
                        accessible-label: "Photos d’artistes";
                        toggled => { AppState.set-artist-photos(self.checked); }
                    }
                }
            }
            SettingsCard {
                HorizontalLayout {
                    padding: 14px;
                    spacing: 16px;
                    VerticalLayout {
                        spacing: 4px;
                        Txt { role: TextRole.headline; text: "Lire d’un simple clic"; }
                        Txt {
                            role: TextRole.callout;
                            text: "Un clic sur un morceau le lance. Sinon, un clic le sélectionne et un double clic le lance.";
                            color: Tokens.text-secondary;
                            wrap: word-wrap;
                            height: self.preferred-height;
                        }
                    }
                    Switch {
                        checked: AppState.is-single-click-play;
                        accessible-label: "Lire d’un simple clic";
                        toggled => { AppState.set-single-click-play(self.checked); }
                    }
                }
            }
            Rectangle { height: 12px; }
            Txt { role: TextRole.title-3; text: "Raccourcis clavier"; height: 32px; vertical-alignment: center; }
            SettingsCard {
                ShortcutList { padding: 14px; }
            }
            Rectangle { height: 12px; }
            Txt { role: TextRole.title-3; text: "À propos"; height: 32px; vertical-alignment: center; }
            SettingsCard {
                HorizontalLayout {
                    padding: 14px;
                    spacing: 16px;
                    VerticalLayout {
                        spacing: 4px;
                        Txt { role: TextRole.headline; text: "Pistolame " + AppState.current-version; }
                        Txt {
                            role: TextRole.callout;
                            text: AppState.update-check-status != "" ? AppState.update-check-status : "Lecteur audio sans perte, GPL-3.0. Les mises à jour sont vérifiées chaque jour.";
                            color: Tokens.text-secondary;
                            wrap: word-wrap;
                            height: self.preferred-height;
                        }
                    }
                    PillButton {
                        width: 236px;
                        label: "Rechercher des mises à jour";
                        icon: Icons.arrows-clockwise;
                        clicked => { AppState.check-for-updates(); }
                    }
                }
            }
        }
    }
}

// Label/value cells in `columns` columns (file information, measurements).
component InfoGrid inherits Rectangle {
    in property <[DataCell]> cells;
    in property <int> columns: 3;
    property <length> cell-width: root.width / root.columns;
    height: Math.ceil(root.cells.length / root.columns) * 52px;
    for cell[index] in root.cells: Rectangle {
        x: Math.mod(index, root.columns) * root.cell-width;
        y: Math.floor(index / root.columns) * 52px;
        width: root.cell-width;
        height: 52px;
        Txt { x: 14px; y: 8px; width: parent.width - 28px; role: TextRole.caption; text: cell.label; color: Tokens.text-secondary; overflow: elide; }
        Txt { x: 14px; y: 24px; width: parent.width - 28px; role: TextRole.body-medium; text: cell.value; overflow: elide; }
    }
}

// The verdict pill: neutral, good (green) or warning (amber).
component VerdictPill inherits Rectangle {
    in property <string> label;
    in property <int> tone;
    height: 28px;
    width: verdict-label.preferred-width + 28px;
    border-radius: 14px;
    background: root.tone == 1 ? Tokens.status-ok-tint : root.tone == 2 ? Tokens.status-caution-tint : Tokens.fill-control;
    verdict-label := Txt {
        x: 14px;
        height: parent.height;
        vertical-alignment: center;
        role: TextRole.body-medium;
        text: root.label;
        color: root.tone == 1 ? Tokens.status-ok : root.tone == 2 ? Tokens.status-caution : Tokens.text-primary;
    }
}

// The current track follows playback independently of the album being browsed. Top: the
// track and everything about its file; scrolling down: signal path, authenticity (Nyquist's
// analysis) and spectrogram.
export component NowPlaying inherits Rectangle {
    ScrollView {
        content-y <=> AppState.now-playing-scroll-y;
        VerticalLayout {
            alignment: start;
            padding-left: 32px;
            padding-right: 52px;
            padding-top: 16px;
            padding-bottom: 32px;
            spacing: 14px;
            HorizontalLayout {
                height: 28px;
                spacing: 6px;
                alignment: start;
                IconButton {
                    width: 28px; height: 28px;
                    icon: Icons.caret-left; icon-color: Tokens.accent;
                    label: "Retour à la vue précédente";
                    clicked => { AppState.navigate-back(); }
                }
                Txt { height: 28px; vertical-alignment: center; text: "À l'écoute"; color: Tokens.text-secondary; }
            }
            // Track header.
            HorizontalLayout {
                spacing: 28px;
                height: 220px;
                Artwork { width: 220px; height: 220px; source: AppState.lcd-artwork; }
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    Txt { role: TextRole.label; text: "MORCEAU EN COURS"; color: Tokens.text-secondary; }
                    Txt { role: TextRole.display; text: AppState.lcd-title; overflow: elide; }
                    HorizontalLayout {
                        alignment: start;
                        height: 28px;
                        TextLink {
                            role: TextRole.title-2; available-width: 600px; text: AppState.current-artist;
                            text-color: Tokens.accent; hover-text-color: Tokens.accent-hover;
                            clicked => { AppState.open-current-artist(); }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        height: 20px;
                        TextLink {
                            available-width: 600px; text: AppState.current-album;
                            clicked => { AppState.open-current-album(); }
                        }
                    }
                    Rectangle { height: 8px; }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        PillButton {
                            label: AppState.is-playing ? "Pause" : "Lecture";
                            icon: AppState.is-playing ? Icons.pause-fill : Icons.play-fill; is-primary: true;
                            clicked => { AppState.toggle-play(); }
                        }
                        PillButton { label: "Voir l'album"; icon: Icons.vinyl-record; clicked => { AppState.open-current-album(); } }
                    }
                    Txt { role: TextRole.caption; text: AppState.elapsed-label + " / " + AppState.current-duration; color: Tokens.text-secondary; }
                }
            }
            // File information.
            Txt { role: TextRole.title-3; text: "Informations sur le fichier"; height: 32px; vertical-alignment: bottom; }
            SettingsCard {
                height: info-grid.height + path-row.height + 12px;
                info-grid := InfoGrid { y: 6px; cells: AppState.track-info-cells; columns: 4; }
                path-row := Rectangle {
                    y: info-grid.height + 6px;
                    height: 40px;
                    Rectangle { x: 14px; y: 0px; width: parent.width - 28px; height: 1px; background: Tokens.separator; }
                    Txt { x: 14px; width: parent.width - 28px - 200px; height: parent.height; vertical-alignment: center; role: TextRole.caption; text: AppState.current-path; color: Tokens.text-secondary; overflow: elide; }
                    Txt {
                        x: parent.width - 14px - self.width; height: parent.height; vertical-alignment: center;
                        role: TextRole.callout-medium; text: AppState.reveal-label; color: Tokens.accent;
                        TouchArea { mouse-cursor: pointer; clicked => { AppState.reveal-current-track(); } }
                    }
                }
            }
            // Signal path.
            Txt { role: TextRole.title-3; text: "Chemin du signal"; height: 40px; vertical-alignment: bottom; }
            SettingsCard {
                height: 236px;
                Badge {
                    x: 14px; y: 14px; label: AppState.badge-label;
                    kind: AppState.is-bit-perfect ? BadgeKind.bit-perfect : AppState.is-shared ? BadgeKind.shared : BadgeKind.unknown;
                }
                SignalPath { x: 14px; y: 54px; width: 360px; steps: AppState.path-steps; }
                Txt { x: 410px; y: 14px; role: TextRole.headline; text: "Vérification"; }
                Text { x: 410px; y: 40px; width: parent.width - 424px; height: 54px; text: AppState.transmission-text; wrap: word-wrap; color: AppState.transmission-ok ? Tokens.status-ok : Tokens.text-secondary; }
                Text { x: 410px; y: 98px; width: parent.width - 424px; height: 54px; text: AppState.integrity-text; wrap: word-wrap; color: AppState.integrity-ok ? Tokens.status-ok : Tokens.text-secondary; }
                Txt { x: 410px; y: 158px; width: parent.width - 424px; role: TextRole.caption; text: AppState.underrun-label; color: Tokens.text-secondary; }
                PillButton { x: 410px; y: 186px; label: "Détails"; icon: Icons.seal-check; clicked => { AppState.is-popover-open = true; } }
            }
            // Authenticity (Nyquist).
            Txt { role: TextRole.title-3; text: "Authenticité"; height: 40px; vertical-alignment: bottom; }
            if AppState.authenticity-state != 2: SettingsCard {
                height: 64px;
                Txt {
                    x: 14px; width: parent.width - 28px; y: (parent.height - self.height) / 2;
                    text: AppState.authenticity-state == 1 ? "Analyse du fichier en cours…" : AppState.authenticity-state == 3 ? "Analyse impossible : " + AppState.authenticity-error : "Lancez un morceau pour analyser son fichier.";
                    color: Tokens.text-secondary;
                    wrap: word-wrap; height: self.preferred-height; overflow: clip;
                }
            }
            if AppState.authenticity-state == 2: SettingsCard {
                height: authenticity-layout.preferred-height;
                authenticity-layout := VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        height: 28px;
                        VerdictPill { label: AppState.authenticity-verdict; tone: AppState.authenticity-tone; }
                        Txt { height: 28px; vertical-alignment: center; role: TextRole.callout; text: AppState.authenticity-strength; color: Tokens.text-secondary; }
                    }
                    Txt { text: AppState.authenticity-blurb; wrap: word-wrap; height: self.preferred-height; overflow: clip; color: Tokens.text-secondary; }
                    for finding in AppState.authenticity-findings: VerticalLayout {
                        spacing: 2px;
                        Txt { role: TextRole.body-medium; text: finding.label; color: Tokens.status-caution; wrap: word-wrap; height: self.preferred-height; overflow: clip; }
                        Txt { role: TextRole.callout; text: finding.value; color: Tokens.text-secondary; wrap: word-wrap; height: self.preferred-height; overflow: clip; }
                    }
                    Rectangle { height: 1px; background: Tokens.separator; }
                    InfoGrid { cells: AppState.authenticity-measures; columns: 4; }
                    Rectangle { height: 1px; background: Tokens.separator; }
                    Txt { role: TextRole.headline; text: "Indices"; }
                    for indicator in AppState.authenticity-indicators: HorizontalLayout {
                        spacing: 8px;
                        Txt { width: 10px; text: "•"; color: Tokens.text-tertiary; }
                        Txt { role: TextRole.callout; text: indicator; wrap: word-wrap; height: self.preferred-height; overflow: clip; color: Tokens.text-secondary; }
                    }
                    Rectangle { height: 2px; }
                    Txt { role: TextRole.caption; text: AppState.authenticity-disclaimer; wrap: word-wrap; height: self.preferred-height; overflow: clip; color: Tokens.text-tertiary; }
                }
            }
            // Spectrogram.
            if AppState.has-spectrogram: Txt { role: TextRole.title-3; text: "Spectrogramme"; height: 40px; vertical-alignment: bottom; }
            if AppState.has-spectrogram: Rectangle {
                height: 280px;
                Txt { x: 0px; y: 0px; width: 52px; role: TextRole.caption; text: AppState.spectrogram-top-label; color: Tokens.text-secondary; }
                Txt { x: 0px; y: (240px - 14px) / 2; width: 52px; role: TextRole.caption; text: AppState.spectrogram-middle-label; color: Tokens.text-secondary; }
                Txt { x: 0px; y: 240px - 14px; width: 52px; role: TextRole.caption; text: "0 kHz"; color: Tokens.text-secondary; }
                Rectangle {
                    x: 56px; y: 0px; width: parent.width - 56px; height: 240px;
                    border-radius: 6px;
                    clip: true;
                    background: #000004;
                    Image { width: parent.width; height: parent.height; source: AppState.spectrogram; image-fit: fill; }
                }
                Txt { x: 56px; y: 248px; role: TextRole.caption; text: "0:00"; color: Tokens.text-secondary; }
                Txt { x: parent.width - 120px; y: 248px; width: 120px; horizontal-alignment: right; role: TextRole.caption; text: AppState.spectrogram-end-label; color: Tokens.text-secondary; }
            }
            // Pointer to the full tool.
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Txt { role: TextRole.caption; text: AppState.nyquist-note; wrap: word-wrap; height: self.preferred-height; overflow: clip; color: Tokens.text-tertiary; }
            }
            Txt {
                role: TextRole.caption;
                text: "Découvrir Nyquist →";
                color: Tokens.accent;
                TouchArea { mouse-cursor: pointer; clicked => { AppState.open-nyquist(); } }
            }
        }
    }
}

// Single-line field in the search field's style, with a caption above it.
export component LabeledField inherits VerticalLayout {
    in property <string> caption;
    in-out property <string> text;
    spacing: 6px;
    Txt { role: TextRole.label; text: root.caption; color: Tokens.text-secondary; }
    Rectangle {
        height: 30px;
        border-radius: 7px;
        background: Tokens.surface-field;
        border-width: input.has-focus ? 2px : 0px;
        border-color: Tokens.focus-ring;
        input := TextInput {
            x: 10px;
            width: parent.width - 20px;
            height: parent.height;
            single-line: true;
            vertical-alignment: center;
            font-family: "Inter";
            font-size: 13px;
            color: Tokens.text-primary;
            selection-background-color: Tokens.accent.with-alpha(0.35);
            selection-foreground-color: Tokens.text-primary;
            accessible-label: root.caption;
            text <=> root.text;
        }
    }
}

// "Modifier l'album": what the app shows for an album. The music files are never modified.
export component AlbumEditor inherits Rectangle {
    width: 500px;
    // Grows with the artists list; the cover column needs at least 360px.
    height: max(360px, 64px + fields.preferred-height + 24px + 64px);
    border-radius: 12px;
    background: Tokens.surface-raised;
    border-width: 1px;
    border-color: Tokens.border-raised;
    drop-shadow-offset-y: 12px;
    drop-shadow-blur: 32px;
    drop-shadow-color: Tokens.shadow-popover;
    // Swallows clicks so that only the scrim behind closes nothing by accident.
    TouchArea { }
    Txt { x: 24px; y: 22px; role: TextRole.title-3; text: "Modifier l’album"; }
    Artwork { x: 24px; y: 64px; width: 132px; height: 132px; source: AppState.editor-artwork; }
    PillButton {
        x: 24px; y: 208px; width: 132px;
        label: "Choisir…";
        icon: Icons.pencil-simple;
        clicked => { AppState.editor-choose-artwork(); }
    }
    Rectangle {
        x: 24px; y: 246px; width: 132px; height: 20px;
        visible: AppState.editor-has-custom-artwork;
        Txt {
            role: TextRole.callout;
            text: "Rétablir l’originale";
            color: reset-touch.has-hover ? Tokens.accent-hover : Tokens.accent;
            horizontal-alignment: center;
        }
        reset-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { AppState.editor-reset-artwork(); }
        }
    }
    fields := VerticalLayout {
        x: 180px; y: 64px; width: root.width - 204px;
        spacing: 10px;
        alignment: start;
        LabeledField { caption: "TITRE"; text <=> AppState.editor-title; }
        Txt { role: TextRole.label; text: "ARTISTES"; color: Tokens.text-secondary; }
        for artist[index] in AppState.editor-artists: Rectangle {
            height: 28px;
            border-radius: 7px;
            background: Tokens.fill-control;
            Txt { x: 10px; width: parent.width - 44px; height: parent.height; text: artist; overflow: elide; }
            IconButton {
                x: parent.width - 28px; y: 2px; width: 24px; height: 24px;
                icon: Icons.x; icon-size: 12px; icon-color: Tokens.text-secondary;
                label: "Retirer " + artist;
                clicked => { AppState.editor-remove-artist(index); }
            }
        }
        HorizontalLayout {
            height: 30px;
            spacing: 8px;
            Rectangle {
                border-radius: 7px;
                background: Tokens.surface-field;
                border-width: new-artist.has-focus ? 2px : 0px;
                border-color: Tokens.focus-ring;
                Txt {
                    x: 10px; width: parent.width - 20px; height: parent.height;
                    text: "Ajouter un artiste"; color: Tokens.text-tertiary;
                    visible: new-artist.text == "";
                }
                new-artist := TextInput {
                    x: 10px; width: parent.width - 20px; height: parent.height;
                    single-line: true;
                    vertical-alignment: center;
                    font-family: "Inter";
                    font-size: 13px;
                    color: Tokens.text-primary;
                    selection-background-color: Tokens.accent.with-alpha(0.35);
                    selection-foreground-color: Tokens.text-primary;
                    accessible-label: "Ajouter un artiste";
                    text <=> AppState.editor-new-artist;
                    accepted => { AppState.editor-add-artist(); }
                }
            }
            PillButton { width: 96px; label: "Ajouter"; icon: Icons.plus; clicked => { AppState.editor-add-artist(); } }
        }
        if AppState.editor-suggested-artists.length > 0: Txt { role: TextRole.label; text: "DANS LES MORCEAUX"; color: Tokens.text-secondary; }
        if AppState.editor-suggested-artists.length > 0: ListView {
            height: min(AppState.editor-suggested-artists.length * 26px, 130px);
            for suggestion[index] in AppState.editor-suggested-artists: Rectangle {
                height: 26px;
                border-radius: 6px;
                background: suggestion-touch.has-hover ? Tokens.fill-row-hover : transparent;
                Icon { x: 8px; y: 7px; width: 12px; height: 12px; source: Icons.plus; colorize: Tokens.accent; }
                Txt { x: 28px; width: parent.width - 36px; height: parent.height; role: TextRole.callout; text: suggestion; overflow: elide; }
                suggestion-touch := TouchArea { mouse-cursor: pointer; clicked => { AppState.editor-add-suggested-artist(index); } }
            }
        }
        Txt {
            role: TextRole.caption;
            text: "Vos fichiers ne sont pas modifiés. Un album à plusieurs artistes apparaît sous chacun d’eux. Sans titre ni artiste, l’album reprend les informations des fichiers.";
            color: Tokens.text-tertiary;
            wrap: word-wrap;
            height: self.preferred-height;
        }
    }
    Rectangle { x: 0px; y: root.height - 64px; width: root.width; height: 1px; background: Tokens.separator; }
    PillButton {
        x: root.width - 24px - 112px - 10px - 112px; y: root.height - 48px;
        label: "Annuler";
        clicked => { AppState.cancel-album-edit(); }
    }
    PillButton {
        x: root.width - 24px - 112px; y: root.height - 48px;
        is-primary: true;
        label: "Enregistrer";
        clicked => { AppState.save-album-edit(); }
    }
}

// One user playlist: its tracks in order, each removable.
export component PlaylistView inherits Rectangle {
    property <length> list-width: root.width - 64px;
    ScrollView {
        content-y <=> AppState.playlist-scroll-y;
        content-height: 150px + 36px * AppState.playlist-tracks.length + 32px;
        Rectangle {
            x: 32px; y: 24px; width: 56px; height: 56px;
            border-radius: 8px;
            background: Tokens.fill-control;
            clip: true;
            if AppState.playlist-artwork.width == 0: Icon { width: 26px; height: 26px; source: Icons.playlist; colorize: Tokens.accent; }
            if AppState.playlist-artwork.width > 0: Image {
                width: parent.width; height: parent.height;
                source: AppState.playlist-artwork; image-fit: cover;
            }
        }
        Txt { x: 104px; y: 26px; width: root.list-width - 72px - 76px; role: TextRole.display; text: AppState.playlist-title; overflow: elide; }
        Txt { x: 104px; y: 60px; width: root.list-width - 72px; role: TextRole.callout; text: AppState.playlist-meta; color: Tokens.text-secondary; }
        ActionMenuButton {
            x: root.width - 32px - 28px - 8px - 28px; y: 24px;
            label: "Actions pour la playlist";
            action(kind) => {
                AppState.track-action({ source: TrackSource.playlist, album: 0, track: 0, position: 0 }, kind);
            }
        }
        IconButton {
            x: root.width - 32px - 28px; y: 24px; width: 28px; height: 28px;
            icon: Icons.pencil-simple; icon-color: Tokens.text-secondary;
            label: "Modifier la playlist";
            clicked => { AppState.begin-playlist-edit(); }
        }
        PillButton {
            x: 32px; y: 96px;
            is-primary: true;
            label: "Lecture";
            icon: Icons.play-fill;
            clicked => { AppState.play-playlist-row(0); }
        }
        if AppState.playlist-tracks.length == 0: Txt {
            x: 32px; y: 152px; width: root.list-width;
            text: "Cette playlist est vide. Ajoutez des morceaux avec le bouton + d’un album ou d’un morceau.";
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }
        for track[index] in AppState.playlist-tracks: TrackRow {
            x: 32px;
            y: 148px + 36px * index;
            width: root.list-width;
            number: track.number;
            title: track.title;
            subtitle: track.subtitle;
            format-label: track.format-label;
            duration-label: track.duration-label;
            is-odd: Math.mod(index, 2) == 1;
            is-current: track.is-current;
            is-favorite: track.is-favorite;
            is-selected: track.is-selected;
            can-remove: true;
            activated => { AppState.play-playlist-row(index); }
            selected(is-toggle, is-range) => {
                AppState.select-track({ source: TrackSource.playlist-entry, album: 0, track: 0, position: track.position }, is-toggle, is-range);
            }
            action(kind) => {
                AppState.track-action({ source: TrackSource.playlist-entry, album: 0, track: 0, position: track.position }, kind);
            }
        }
    }
}

// A dimmed-window sheet frame shared by the editors.
export component Sheet inherits Rectangle {
    in property <string> title;
    border-radius: 12px;
    background: Tokens.surface-raised;
    border-width: 1px;
    border-color: Tokens.border-raised;
    drop-shadow-offset-y: 12px;
    drop-shadow-blur: 32px;
    drop-shadow-color: Tokens.shadow-popover;
    TouchArea { }
    Txt { x: 24px; y: 22px; role: TextRole.title-3; text: root.title; }
    @children
}

export component PlaylistEditor inherits Sheet {
    title: "Modifier la playlist";
    width: 460px;
    height: 260px;
    Rectangle {
        x: 24px; y: 64px; width: 96px; height: 96px;
        border-radius: 10px;
        background: Tokens.fill-control;
        clip: true;
        if AppState.playlist-editor-artwork.width == 0: Icon { width: 36px; height: 36px; source: Icons.playlist; colorize: Tokens.accent; }
        if AppState.playlist-editor-artwork.width > 0: Image {
            width: parent.width; height: parent.height;
            source: AppState.playlist-editor-artwork; image-fit: cover;
        }
    }
    PillButton {
        x: 24px; y: 168px; width: 96px;
        label: "Choisir…";
        clicked => { AppState.playlist-editor-choose-artwork(); }
    }
    if AppState.playlist-editor-artwork.width > 0: Rectangle {
        x: 24px; y: 204px; width: 96px; height: 18px;
        Txt {
            role: TextRole.callout; text: "Retirer";
            color: remove-touch.has-hover ? Tokens.accent-hover : Tokens.accent;
            horizontal-alignment: center;
        }
        remove-touch := TouchArea { mouse-cursor: pointer; clicked => { AppState.playlist-editor-remove-artwork(); } }
    }
    LabeledField { x: 144px; y: 64px; width: root.width - 168px; caption: "NOM"; text <=> AppState.playlist-editor-name; }
    Rectangle {
        x: 144px; y: 164px; width: 220px; height: 20px;
        HorizontalLayout {
            alignment: start;
            spacing: 6px;
            Icon { width: 14px; source: Icons.queue; colorize: Tokens.accent; }
            Txt { role: TextRole.callout; text: "Exporter en M3U…"; color: Tokens.accent; vertical-alignment: center; }
        }
        TouchArea { mouse-cursor: pointer; clicked => { AppState.export-current-playlist(); } }
    }
    Rectangle {
        x: 144px; y: 132px; width: 180px; height: 20px;
        HorizontalLayout {
            alignment: start;
            spacing: 6px;
            Icon { width: 14px; source: Icons.trash; colorize: Tokens.status-caution; }
            Txt { role: TextRole.callout; text: "Supprimer la playlist"; color: Tokens.status-caution; vertical-alignment: center; }
        }
        TouchArea { mouse-cursor: pointer; clicked => { AppState.delete-current-playlist(); } }
    }
    PillButton {
        x: root.width - 24px - 112px - 10px - 112px; y: root.height - 48px;
        label: "Annuler";
        clicked => { AppState.is-playlist-editor-open = false; }
    }
    PillButton {
        x: root.width - 24px - 112px; y: root.height - 48px;
        is-primary: true;
        label: "Enregistrer";
        clicked => { AppState.save-playlist-edit(); }
    }
}

component PlaylistChoiceRow inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <image> icon;
    in property <bool> has-separator;
    callback clicked();
    height: 40px;
    border-radius: 8px;
    background: touch.pressed ? Tokens.fill-row-pressed : touch.has-hover ? Tokens.fill-row-hover : transparent;
    animate background { duration: 120ms; easing: ease-out-quint; }
    accessible-role: button;
    accessible-label: root.name;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Icon { width: 16px; source: root.icon; colorize: Tokens.accent; }
        Txt { height: root.height; text: root.name; vertical-alignment: center; overflow: elide; }
        Txt { height: root.height; role: TextRole.callout; text: root.detail; color: Tokens.text-secondary; vertical-alignment: center; horizontal-alignment: right; }
    }
    if root.has-separator: Rectangle {
        x: 38px; y: root.height - 1px; width: root.width - 50px; height: 1px;
        background: Tokens.separator;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component AddToPlaylistSheet inherits Sheet {
    title: "Ajouter à une playlist";
    width: 400px;
    height: 132px + 40px * min(AppState.playlists.length + 1, 6);
    Txt {
        x: 24px; y: 48px; width: root.width - 48px;
        role: TextRole.callout; text: AppState.add-to-playlist-subject;
        color: Tokens.text-secondary; overflow: elide;
    }
    Rectangle {
        x: 16px; y: 76px; width: root.width - 32px; height: 40px * min(AppState.playlists.length + 1, 6);
        border-radius: 10px;
        background: Tokens.fill-row-zebra;
        border-width: 1px;
        border-color: Tokens.separator;
        clip: true;
        Flickable {
            content-height: 40px * (AppState.playlists.length + 1);
            VerticalLayout {
                PlaylistChoiceRow {
                    name: "Nouvelle playlist";
                    icon: Icons.plus;
                    has-separator: AppState.playlists.length > 0;
                    clicked => { AppState.add-pending-to-new-playlist(); }
                }
                for item[index] in AppState.playlists: PlaylistChoiceRow {
                    name: item.name;
                    detail: item.track-count + (item.track-count == 1 ? " morceau" : " morceaux");
                    icon: Icons.playlist;
                    has-separator: index < AppState.playlists.length - 1;
                    clicked => { AppState.add-pending-to-playlist(index); }
                }
            }
        }
    }
    PillButton {
        x: root.width - 24px - 112px; y: root.height - 44px;
        label: "Annuler";
        clicked => { AppState.is-add-to-playlist-open = false; }
    }
}

// One track of the "À suivre" panel. Like the other lists, a click selects it (or plays it with
// "Lire d'un simple clic") and a double click plays it. The selected row takes the keyboard:
// Return plays, Delete or Backspace removes a queued track, Alt+Up/Down moves it.
component QueueTrack inherits Rectangle {
    in property <QueueRow> entry;
    // A track queued by hand: it can be removed and moved.
    in property <bool> can-remove;
    in property <bool> can-move-earlier;
    in property <bool> can-move-later;
    callback clicked();
    callback remove();
    callback move(bool /* is-earlier */);
    height: 48px;
    border-radius: 8px;
    property <bool> is-hovered: touch.has-hover || remove-button.has-hover || earlier-button.has-hover || later-button.has-hover;
    background: keyboard.has-focus ? Tokens.fill-row-selected : root.is-hovered ? Tokens.fill-row-hover : transparent;
    accessible-role: button;
    accessible-label: root.entry.title;
    accessible-action-default => { root.clicked(); }
    keyboard := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return {
                root.clicked(); return accept;
            }
            if root.can-remove && (event.text == Key.Delete || event.text == Key.Backspace) {
                root.remove(); return accept;
            }
            if root.can-remove && event.modifiers.alt && event.text == Key.UpArrow {
                if root.can-move-earlier { root.move(true); }
                return accept;
            }
            if root.can-remove && event.modifiers.alt && event.text == Key.DownArrow {
                if root.can-move-later { root.move(false); }
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        clicked => {
            if !AppState.is-single-click-play {
                keyboard.focus();
            } else if !SingleClickGuard.is-double-click-repeat() {
                root.clicked();
            }
        }
        double-clicked => {
            if !AppState.is-single-click-play { root.clicked(); }
        }
    }
    Rectangle {
        x: 8px; y: 6px; width: 36px; height: 36px;
        background: Tokens.surface-field;
        Image { width: parent.width; height: parent.height; source: root.entry.artwork; image-fit: cover; }
    }
    Txt { x: 52px; y: 7px; width: root.width - 52px - 76px; text: root.entry.title; overflow: elide; }
    Txt { x: 52px; y: 25px; width: root.width - 52px - 76px; role: TextRole.callout; text: root.entry.subtitle; color: Tokens.text-secondary; overflow: elide; }
    Txt {
        x: root.width - 76px; y: 16px; width: 40px; role: TextRole.callout;
        text: root.entry.duration-label; color: Tokens.text-secondary; horizontal-alignment: right;
        visible: !(root.can-remove && root.is-hovered);
    }
    earlier-button := IconButton {
        x: root.width - 84px; y: 12px; width: 24px; height: 24px;
        icon: Icons.caret-up; icon-size: 12px; icon-color: Tokens.text-secondary;
        label: "Monter dans la file";
        visible: root.can-remove && root.can-move-earlier;
        opacity: root.is-hovered ? 1 : 0;
        clicked => { root.move(true); }
    }
    later-button := IconButton {
        x: root.width - 58px; y: 12px; width: 24px; height: 24px;
        icon: Icons.caret-down; icon-size: 12px; icon-color: Tokens.text-secondary;
        label: "Descendre dans la file";
        visible: root.can-remove && root.can-move-later;
        opacity: root.is-hovered ? 1 : 0;
        clicked => { root.move(false); }
    }
    remove-button := IconButton {
        x: root.width - 32px; y: 12px; width: 24px; height: 24px;
        icon: Icons.x; icon-size: 14px; icon-color: Tokens.text-secondary;
        label: "Retirer de la file d’attente";
        visible: root.can-remove;
        opacity: root.is-hovered ? 1 : 0;
        clicked => { root.remove(); }
    }
}

// Minuteur de veille: stops playback at the end of the track or after some minutes. No fade:
// the samples stay untouched until the stop (bit-perfect).
component SleepTimerButton inherits Rectangle {
    width: AppState.sleep-timer-label == "" ? 28px : chip.preferred-width;
    height: 28px;
    border-radius: 14px;
    background: AppState.sleep-timer-label == "" ? transparent : Tokens.accent.with-alpha(0.16);
    chip := HorizontalLayout {
        padding-left: AppState.sleep-timer-label == "" ? 7px : 10px;
        padding-right: AppState.sleep-timer-label == "" ? 7px : 10px;
        spacing: 6px;
        Icon {
            width: 14px; source: Icons.moon;
            colorize: AppState.sleep-timer-label == "" ? Tokens.text-secondary : Tokens.accent;
        }
        if AppState.sleep-timer-label != "": Txt {
            role: TextRole.callout-medium; height: 28px; vertical-alignment: center;
            text: AppState.sleep-timer-label; color: Tokens.accent;
        }
    }
    accessible-role: button;
    accessible-label: AppState.sleep-timer-label == "" ? "Minuteur de veille" : "Minuteur de veille : " + AppState.sleep-timer-label;
    accessible-action-default => { menu.show(); }
    TouchArea { mouse-cursor: pointer; clicked => { menu.show(); } }
    menu := PopupWindow {
        x: root.width - 200px;
        y: root.height + 4px;
        width: 200px;
        Rectangle {
            border-radius: 10px;
            background: Tokens.surface-raised;
            border-width: 1px;
            border-color: Tokens.border-raised;
            drop-shadow-offset-y: 8px;
            drop-shadow-blur: 24px;
            drop-shadow-color: Tokens.shadow-popover;
            VerticalLayout {
                padding: 5px;
                MenuRow { icon: Icons.music-note; label: "Fin du morceau"; clicked => { AppState.set-sleep-timer(-1); } }
                for minutes in [15, 30, 45, 60, 90]: MenuRow {
                    icon: Icons.clock-counter-clockwise; label: minutes + " minutes";
                    clicked => { AppState.set-sleep-timer(minutes); }
                }
                if AppState.sleep-timer-label != "": MenuRow {
                    icon: Icons.x; label: "Désactiver"; is-destructive: true;
                    clicked => { AppState.set-sleep-timer(0); }
                }
            }
        }
    }
}

// "À suivre": the current track, the tracks queued by hand, then the rest of the album or
// playlist being played.
export component QueuePanel inherits Rectangle {
    width: 340px;
    background: Tokens.surface-raised;
    border-width: 1px;
    border-color: Tokens.separator;
    // The "Historique" section starts folded.
    property <bool> is-history-shown;
    TouchArea { }
    Txt { x: 20px; y: 18px; role: TextRole.title-3; text: "À suivre"; }
    SleepTimerButton { x: root.width - 16px - 28px - 6px - self.width; y: 14px; }
    IconButton {
        x: root.width - 16px - 28px; y: 14px; width: 28px; height: 28px;
        icon: Icons.x; icon-size: 14px; icon-color: Tokens.text-secondary;
        label: "Fermer la file d’attente";
        clicked => { AppState.is-queue-open = false; }
    }
    Flickable {
        y: 56px;
        height: root.height - 56px;
        content-height: body.preferred-height;
        body := VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-bottom: 16px;
            spacing: 2px;
            alignment: start;
            if !AppState.has-queue-current: Txt {
                height: 40px;
                text: "Lancez un album ou une playlist pour remplir la file.";
                color: Tokens.text-secondary;
                wrap: word-wrap;
            }
            if AppState.queue-played.length > 0: HorizontalLayout {
                height: 28px;
                spacing: 4px;
                alignment: start;
                accessible-role: button;
                accessible-label: root.is-history-shown ? "Masquer l’historique" : "Afficher l’historique";
                accessible-action-default => { root.is-history-shown = !root.is-history-shown; }
                Icon {
                    width: 10px; source: Icons.caret-left; colorize: Tokens.text-secondary;
                    transform-rotation: root.is-history-shown ? -90deg : 180deg;
                }
                Txt {
                    height: 28px; vertical-alignment: center;
                    role: TextRole.label; text: "HISTORIQUE (" + AppState.queue-played.length + ")";
                    color: history-touch.has-hover ? Tokens.text-primary : Tokens.text-secondary;
                    history-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.is-history-shown = !root.is-history-shown; }
                    }
                }
            }
            // Most recent first; a click goes back to that track ("Lire à partir d'ici").
            if root.is-history-shown: VerticalLayout {
                spacing: 2px;
                for item[index] in AppState.queue-played: QueueTrack {
                    entry: item;
                    opacity: 0.7;
                    clicked => { AppState.queue-play-played(index); }
                }
            }
            if AppState.has-queue-current: Txt { height: 24px; role: TextRole.label; text: "EN COURS"; color: Tokens.text-secondary; }
            if AppState.has-queue-current: QueueTrack { entry: AppState.queue-current; }
            if AppState.queue-up-next.length > 0: HorizontalLayout {
                height: 34px;
                padding-top: 10px;
                Txt { role: TextRole.label; text: "ENSUITE DANS LA FILE"; color: Tokens.text-secondary; }
                Rectangle { }
                Txt {
                    role: TextRole.callout; text: "Effacer";
                    color: clear-touch.has-hover ? Tokens.accent-hover : Tokens.accent;
                    clear-touch := TouchArea { mouse-cursor: pointer; clicked => { AppState.queue-clear(); } }
                }
            }
            for item[index] in AppState.queue-up-next: QueueTrack {
                entry: item;
                can-remove: true;
                can-move-earlier: index > 0;
                can-move-later: index < AppState.queue-up-next.length - 1 || AppState.queue-up-next-hidden-count > 0;
                clicked => { AppState.queue-play-up-next(index); }
                remove => { AppState.queue-remove(index); }
                move(is-earlier) => { AppState.queue-move(index, is-earlier); }
            }
            if AppState.queue-up-next-hidden-count > 0: Txt {
                height: 32px;
                vertical-alignment: center;
                role: TextRole.callout;
                text: "… et " + AppState.queue-up-next-hidden-count + " autres morceaux";
                color: Tokens.text-tertiary;
            }
            if AppState.queue-upcoming.length > 0: Txt {
                height: 34px;
                vertical-alignment: bottom;
                role: TextRole.label;
                text: "ENSUITE DEPUIS : " + AppState.queue-context-name;
                color: Tokens.text-secondary;
                overflow: elide;
            }
            for item[index] in AppState.queue-upcoming: QueueTrack {
                entry: item;
                clicked => { AppState.queue-play-upcoming(index); }
            }
            if AppState.queue-upcoming-hidden-count > 0: Txt {
                height: 32px;
                vertical-alignment: center;
                role: TextRole.callout;
                text: "… et " + AppState.queue-upcoming-hidden-count + " autres morceaux";
                color: Tokens.text-tertiary;
            }
        }
    }
}

// "Mise à jour disponible": opened from the green dot in the toolbar.
export component UpdatePanel inherits Rectangle {
    width: 360px;
    height: 330px;
    border-radius: 12px;
    background: Tokens.surface-raised;
    border-width: 1px;
    border-color: Tokens.border-raised;
    drop-shadow-offset-y: 8px;
    drop-shadow-blur: 24px;
    drop-shadow-color: Tokens.shadow-popover;
    TouchArea { }
    Rectangle {
        x: 20px; y: 22px; width: 10px; height: 10px; border-radius: 5px;
        background: Tokens.status-ok;
    }
    Txt { x: 40px; y: 16px; role: TextRole.title-3; text: "Mise à jour disponible"; }
    Txt {
        x: 20px; y: 48px; width: root.width - 40px;
        role: TextRole.headline;
        text: "Pistolame " + AppState.update-version;
    }
    Txt {
        x: 20px; y: 68px; width: root.width - 40px;
        role: TextRole.callout;
        text: "Version installée : " + AppState.current-version;
        color: Tokens.text-secondary;
    }
    Rectangle {
        x: 20px; y: 96px; width: root.width - 40px; height: 140px;
        border-radius: 8px;
        background: Tokens.fill-row-zebra;
        clip: true;
        Flickable {
            content-height: notes.preferred-height + 20px;
            notes := Txt {
                x: 10px; y: 10px; width: parent.width - 20px;
                role: TextRole.callout;
                text: AppState.update-notes;
                wrap: word-wrap;
                height: self.preferred-height;
            }
        }
    }
    Txt {
        x: 20px; y: 246px; width: root.width - 40px;
        role: TextRole.callout;
        text: AppState.update-status != "" ? AppState.update-status : "L’application se fermera et se rouvrira toute seule, déjà à jour.";
        color: AppState.update-status != "" && !AppState.is-updating ? Tokens.status-caution : Tokens.text-secondary;
        wrap: word-wrap;
        height: 32px;
    }
    PillButton {
        x: root.width - 20px - 132px - 10px - 112px; y: root.height - 48px;
        label: "Plus tard";
        clicked => { AppState.is-update-panel-open = false; }
    }
    PillButton {
        x: root.width - 20px - 132px; y: root.height - 48px; width: 132px;
        is-primary: true;
        label: AppState.is-updating ? "En cours…" : "Mettre à jour";
        clicked => {
            if !AppState.is-updating {
                AppState.start-update();
            }
        }
    }
}

component ArtistTile inherits Rectangle {
    in property <length> tile;
    in property <ArtistCard> artist;
    callback open();
    width: root.tile;
    height: root.tile + 52px;
    accessible-role: button;
    accessible-label: root.artist.name;
    accessible-action-default => { root.open(); }
    // Round portrait (the newest album cover), as in Apple Music's artist list.
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.tile;
        height: root.tile;
        border-radius: root.tile / 2;
        clip: true;
        background: Tokens.surface-field;
        drop-shadow-offset-y: 2px;
        drop-shadow-blur: 8px;
        drop-shadow-color: Tokens.shadow-artwork;
        Image { width: parent.width; height: parent.height; source: root.artist.artwork; image-fit: cover; }
        if touch.has-hover: Rectangle { background: Tokens.overlay-artwork-hover; }
    }
    Txt { x: 0px; y: root.tile + 10px; width: root.tile; role: TextRole.body-medium; text: root.artist.name; horizontal-alignment: center; overflow: elide; }
    Txt { x: 0px; y: root.tile + 28px; width: root.tile; role: TextRole.callout; text: root.artist.detail; color: Tokens.text-secondary; horizontal-alignment: center; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.open(); } }
}

export component ArtistsView inherits Rectangle {
    property <length> inner-width: root.width - 64px;
    property <int> columns: Math.clamp(Math.floor((root.inner-width + 24px) / 164px), 3, 9);
    property <length> tile: Math.floor((root.inner-width - 24px * (root.columns - 1)) / root.columns / 1px) * 1px;
    property <int> row-count: Math.ceil(AppState.artists.length / root.columns);
    Txt { role: TextRole.display; x: 32px; y: 24px; width: root.width - 64px; text: "Artistes"; }
    Txt {
        x: 32px; y: 58px; role: TextRole.callout; color: Tokens.text-secondary;
        visible: AppState.artists.length > 0;
        text: AppState.artists.length + (AppState.artists.length == 1 ? " artiste" : " artistes");
    }
    ListView {
        y: 88px;
        height: root.height - 88px;
        content-y <=> AppState.artists-scroll-y;
        for row-index in root.row-count: Rectangle {
            height: root.tile + 76px;
            for column in root.columns: Rectangle {
                if row-index * root.columns + column < AppState.artists.length: ArtistTile {
                    x: 32px + column * (root.tile + 24px);
                    y: 0px;
                    tile: root.tile;
                    artist: AppState.artists[row-index * root.columns + column];
                    open => { AppState.open-artist(row-index * root.columns + column); }
                }
            }
        }
    }
    if AppState.artists.length == 0: Txt {
        y: 200px; width: root.width;
        text: "Aucun artiste : importez de la musique pour remplir cette vue.";
        color: Tokens.text-secondary;
        horizontal-alignment: center;
    }
}

// Column geometry shared by the "Morceaux" header and rows. Title and album/artist share the
// width left by the fixed columns.
component TrackColumns {
    in property <length> total-width;
    out property <length> fixed-width: 56px + 128px + 56px + 32px + 3 * 16px;
    out property <length> flexible-width: Math.max(0px, root.total-width - 12px - root.fixed-width - 3 * 16px);
    out property <length> title-x: 12px;
    out property <length> title-width: root.flexible-width * 0.4;
    out property <length> artist-x: root.title-x + root.title-width + 16px;
    out property <length> artist-width: root.flexible-width * 0.3;
    out property <length> album-x: root.artist-x + root.artist-width + 16px;
    out property <length> album-width: root.flexible-width * 0.3;
    out property <length> year-x: root.album-x + root.album-width + 16px;
    out property <length> format-x: root.year-x + 56px + 16px;
    out property <length> duration-x: root.format-x + 128px + 16px;
}

component ColumnHeader inherits Rectangle {
    in property <string> label;
    in property <bool> is-sorted;
    in property <bool> is-descending;
    in property <bool> is-right-aligned;
    callback clicked();
    height: 28px;
    accessible-role: button;
    accessible-label: "Trier par " + root.label;
    Txt {
        role: TextRole.label;
        x: 0px;
        width: root.width - (root.is-sorted ? 14px : 0px);
        height: root.height;
        vertical-alignment: center;
        horizontal-alignment: root.is-right-aligned ? right : left;
        text: root.label;
        color: root.is-sorted ? Tokens.text-primary : Tokens.text-secondary;
        overflow: elide;
    }
    if root.is-sorted: Image {
        x: root.width - 10px;
        y: (root.height - 10px) / 2;
        width: 10px; height: 10px;
        source: Icons.caret-left;
        colorize: Tokens.accent;
        transform-rotation: root.is-descending ? 270deg : 90deg;
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component LibraryTrackLine inherits Rectangle {
    in property <LibraryTrackRow> track;
    in property <length> title-x; in property <length> title-width;
    in property <length> artist-x; in property <length> artist-width;
    in property <length> album-x; in property <length> album-width;
    in property <length> year-x; in property <length> format-x; in property <length> duration-x;
    in property <bool> is-odd;
    property <bool> is-current: root.track.path != "" && root.track.path == AppState.current-track-path;
    property <bool> is-hovered: touch.has-hover || menu-button.has-hover || artist-link.has-hover || album-link.has-hover;
    callback activated();
    callback selected(bool, bool);
    callback action(TrackAction);
    height: 32px;
    border-radius: 6px;
    background: touch.pressed ? Tokens.fill-row-pressed : root.track.is-selected ? Tokens.fill-row-selected : root.is-hovered ? Tokens.fill-row-hover : root.is-odd ? Tokens.fill-row-zebra : transparent;
    accessible-role: button;
    accessible-label: root.track.title + ", " + root.track.artist;
    accessible-action-default => { root.activated(); }
    Txt {
        role: root.is-current ? TextRole.body-medium : TextRole.body;
        x: root.title-x; width: root.title-width; height: root.height; vertical-alignment: center;
        text: root.track.title; overflow: elide;
        color: root.is-current ? Tokens.accent : Tokens.text-primary;
    }
    Txt { x: root.year-x; width: 56px; height: root.height; vertical-alignment: center; text: root.track.year; horizontal-alignment: right; color: Tokens.text-secondary; }
    Txt { role: TextRole.caption; x: root.format-x; width: 128px; height: root.height; vertical-alignment: center; text: root.track.format-label; horizontal-alignment: right; color: Tokens.text-secondary; }
    Txt { x: root.duration-x; width: 56px; height: root.height; vertical-alignment: center; text: root.track.duration-label; horizontal-alignment: right; color: Tokens.text-secondary; }
    touch := TrackRowTouch {
        activated => { root.activated(); }
        selected(is-toggle, is-range) => { root.selected(is-toggle, is-range); }
        menu-requested(x, y) => { menu-button.open-at(x - menu-button.x, y - menu-button.y); }
    }
    // Artist and album open their page; the rest of the cell still selects the row.
    artist-link := TextLink {
        x: root.artist-x; available-width: root.artist-width; height: root.height;
        text: root.track.artist;
        clicked => { root.action(TrackAction.go-to-artist); }
    }
    album-link := TextLink {
        x: root.album-x; available-width: root.album-width; height: root.height;
        text: root.track.album;
        clicked => { root.action(TrackAction.go-to-album); }
    }
    if root.track.is-favorite && !root.is-hovered: Icon {
        x: root.width - 8px - 28px + 8px;
        y: (root.height - 12px) / 2;
        width: 12px;
        height: 12px;
        source: Icons.heart-fill;
        colorize: Tokens.accent;
    }
    menu-button := ActionMenuButton {
        x: root.width - 8px - 28px;
        y: 2px;
        label: "Actions pour " + root.track.title;
        can-favorite: true;
        is-favorite: root.track.is-favorite;
        can-go-to-album: true;
        opacity: root.is-hovered ? 1 : 0;
        action(kind) => { root.action(kind); }
    }
}

// "Morceaux": every track of the library in a table sorted by the clicked column.
export component TracksView inherits Rectangle {
    property <[string]> column-labels: ["Titre", "Artiste", "Album", "Année", "Format", "Durée"];
    columns := TrackColumns { total-width: root.width - 64px; }
    Txt { role: TextRole.display; x: 32px; y: 24px; width: root.width - 64px; text: "Morceaux"; }
    Txt {
        x: 32px; y: 58px; role: TextRole.callout; color: Tokens.text-secondary;
        text: AppState.library-tracks.length + (AppState.library-tracks.length == 1 ? " morceau" : " morceaux");
    }
    // "Favoris" filter, at the top right (brass when on).
    HeaderButton {
        x: root.width - 32px - self.width;
        y: 26px;
        icon: AppState.is-favorites-only ? Icons.heart-fill : Icons.heart;
        label: "Favoris";
        accessible-name: AppState.is-favorites-only ? "Afficher tous les morceaux" : "Afficher seulement les favoris";
        is-active: AppState.is-favorites-only;
        clicked => { AppState.toggle-favorites-only(); }
    }
    Rectangle {
        x: 32px; y: 84px; width: root.width - 64px; height: 28px;
        ColumnHeader { x: columns.title-x; width: columns.title-width; label: root.column-labels[0]; is-sorted: AppState.track-sort-column == 0; is-descending: AppState.is-track-sort-descending; clicked => { AppState.sort-tracks(0); } }
        ColumnHeader { x: columns.artist-x; width: columns.artist-width; label: root.column-labels[1]; is-sorted: AppState.track-sort-column == 1; is-descending: AppState.is-track-sort-descending; clicked => { AppState.sort-tracks(1); } }
        ColumnHeader { x: columns.album-x; width: columns.album-width; label: root.column-labels[2]; is-sorted: AppState.track-sort-column == 2; is-descending: AppState.is-track-sort-descending; clicked => { AppState.sort-tracks(2); } }
        ColumnHeader { x: columns.year-x; width: 56px; is-right-aligned: true; label: root.column-labels[3]; is-sorted: AppState.track-sort-column == 3; is-descending: AppState.is-track-sort-descending; clicked => { AppState.sort-tracks(3); } }
        ColumnHeader { x: columns.format-x; width: 128px; is-right-aligned: true; label: root.column-labels[4]; is-sorted: AppState.track-sort-column == 4; is-descending: AppState.is-track-sort-descending; clicked => { AppState.sort-tracks(4); } }
        ColumnHeader { x: columns.duration-x; width: 56px; is-right-aligned: true; label: root.column-labels[5]; is-sorted: AppState.track-sort-column == 5; is-descending: AppState.is-track-sort-descending; clicked => { AppState.sort-tracks(5); } }
        Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.separator; }
    }
    ListView {
        x: 32px;
        y: 116px;
        width: root.width - 64px;
        height: root.height - 116px;
        content-y <=> AppState.tracks-scroll-y;
        for track[index] in AppState.library-tracks: LibraryTrackLine {
            track: track;
            is-odd: Math.mod(index, 2) == 1;
            title-x: columns.title-x; title-width: columns.title-width;
            artist-x: columns.artist-x; artist-width: columns.artist-width;
            album-x: columns.album-x; album-width: columns.album-width;
            year-x: columns.year-x; format-x: columns.format-x; duration-x: columns.duration-x;
            activated => { AppState.play-library-track(index); }
            selected(is-toggle, is-range) => {
                AppState.select-track({ source: TrackSource.library-track, album: 0, track: 0, position: index }, is-toggle, is-range);
            }
            action(kind) => {
                AppState.track-action({ source: TrackSource.library-track, album: 0, track: 0, position: index }, kind);
            }
        }
    }
    if AppState.library-tracks.length == 0: Txt {
        y: 200px; width: root.width;
        text: AppState.is-favorites-only
            ? "Aucun favori : choisissez « Ajouter aux favoris » dans le menu « … » d’un morceau."
            : "Aucun morceau : importez de la musique pour remplir cette vue.";
        color: Tokens.text-secondary;
        horizontal-alignment: center;
    }
}

// A block of album tiles, at most `max-rows` rows, for the "Ajouts récents" page.
component AlbumShelf inherits Rectangle {
    in property <[AlbumCard]> albums;
    in property <int> columns;
    in property <length> tile;
    in property <int> max-rows: 2;
    property <int> shown: Math.min(root.albums.length, root.columns * root.max-rows);
    property <length> pitch: root.tile + 64px;
    height: Math.ceil(root.shown / root.columns) * root.pitch;
    for album[index] in root.albums: AlbumTile {
        visible: index < root.shown;
        x: 32px + Math.mod(index, root.columns) * (root.tile + 24px);
        y: Math.floor(index / root.columns) * root.pitch;
        tile: root.tile;
        album: album;
        open => { AppState.open-album(album.catalog-index); }
        play => { AppState.play-track(album.catalog-index, 0); }
    }
}

// "Ajouts récents": the latest albums added, then the ones played last.
export component RecentView inherits Rectangle {
    property <length> inner-width: root.width - 64px;
    property <int> columns: Math.clamp(Math.floor((root.inner-width + 24px) / 184px), 3, 8);
    property <length> tile: Math.floor((root.inner-width - 24px * (root.columns - 1)) / root.columns / 1px) * 1px;
    Txt { role: TextRole.display; x: 32px; y: 24px; width: root.width - 64px; text: "Ajouts récents"; }
    Flickable {
        y: 76px;
        height: root.height - 76px;
        content-y <=> AppState.recent-scroll-y;
        // Same top margin as the album grid's first row.
        content-height: 12px + added.height + (AppState.recently-played-albums.length > 0 ? 56px + played.height : 0px) + 32px;
        added := AlbumShelf {
            y: 12px;
            albums: AppState.recently-added-albums;
            columns: root.columns;
            tile: root.tile;
        }
        if AppState.recently-played-albums.length > 0: Txt {
            x: 32px; y: 12px + added.height + 12px; role: TextRole.title-3; text: "Écoutés récemment";
        }
        played := AlbumShelf {
            y: 12px + added.height + 56px;
            visible: AppState.recently-played-albums.length > 0;
            albums: AppState.recently-played-albums;
            columns: root.columns;
            tile: root.tile;
        }
    }
    if AppState.recently-added-albums.length == 0: Txt {
        y: 200px; width: root.width;
        text: "Rien pour l’instant : importez de la musique pour remplir cette vue.";
        color: Tokens.text-secondary;
        horizontal-alignment: center;
    }
}
