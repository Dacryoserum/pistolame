// Data and callbacks shared between the Slint components and the Rust controller.

export struct AlbumCard {
    catalog-index: int,
    title: string,
    artist: string,
    artwork: image,
}

export struct TrackRowData {
    number: int,
    title: string,
    format-label: string,
    duration-label: string,
    // A "Disque 2" heading row instead of a track (multi-disc albums).
    is-disc-header: bool,
    // Index of the track in the album (rows and tracks differ when there are headings).
    track-index: int,
}

export struct PathStep {
    label: string,
    value: string,
    is-transparent: bool,
}

export struct DataCell {
    label: string,
    value: string,
}

export struct DetailInfo {
    title: string,
    artist: string,
    meta-line: string,
    artwork: image,
    footer-line: string,
    is-authentic: bool,
    verdict-label: string,
    summary: string,
    spectrogram: image,
    should-mark-cutoff: bool,
    cutoff-fraction: float,
    cutoff-label: string,
    nyquist-label: string,
    zero-label: string,
    cells: [DataCell],
}

export enum ViewKind {
    grid,
    detail,
    placeholder,
    now-playing,
    playlist,
}

// Where a track action applies: one track of an album, a whole album, one playlist entry or a
// whole playlist.
export enum TrackSource {
    album-track,
    album,
    playlist-entry,
    playlist,
    // A track in the search results (position = its index there).
    search-result,
    // A row of the "Morceaux" table (position = its index there).
    library-track,
}

export struct TrackTarget {
    source: TrackSource,
    album: int,
    track: int,
    // Position among every entry of the open playlist.
    position: int,
}

export enum TrackAction {
    play-next,
    add-to-queue,
    add-to-playlist,
    remove-from-playlist,
    reveal-in-file-manager,
}

export struct QueueRow {
    title: string,
    subtitle: string,
    duration-label: string,
    artwork: image,
}

// One row of the "Morceaux" table.
export struct LibraryTrackRow {
    title: string,
    artist: string,
    album: string,
    year: string,
    format-label: string,
    duration-label: string,
    // File path, compared with `AppState.current-track-path` to mark the playing row.
    path: string,
}

export struct ArtistCard {
    name: string,
    detail: string,
    artwork: image,
}

export struct PlaylistItem {
    name: string,
    track-count: int,
    artwork: image,
}

export struct PlaylistTrackRow {
    // Position among every entry of the playlist (stable for removal).
    position: int,
    number: int,
    title: string,
    subtitle: string,
    format-label: string,
    duration-label: string,
    is-current: bool,
}

export global AppState {
    in property <[string]> device-names;
    in property <int> selected-device-index: -1;
    in property <bool> exclusive;
    in property <bool> show-exclusive-notice;
    in property <string> transmission-text;
    in property <string> integrity-text;
    in property <string> transmission-digest;
    in property <string> integrity-digest;
    in property <bool> transmission-ok;
    in property <bool> integrity-ok;
    in-out property <string> message;
    in property <string> import-status;
    in property <string> underrun-label: "Coupures : 0";
    callback import-files();
    callback import-folder();
    callback stop();
    callback select-device(int);
    callback refresh-devices();
    callback set-exclusive(bool);
    callback dismiss-notice();

    in property <bool> has-current-track;
    in property <string> current-artist;
    in property <string> current-album;
    in property <string> current-format;
    in property <string> current-duration;
    in property <string> current-filename;
    in-out property <ViewKind> previous-view: ViewKind.grid;
    callback open-current-album();
    // "Modifier l'album" sheet: title, artist and cover shown in the app, stored in the
    // library; the music files are never modified.
    in-out property <bool> is-album-editor-open;
    in-out property <string> editor-title;
    in-out property <string> editor-artist;
    in property <image> editor-artwork;
    in property <bool> editor-has-custom-artwork;
    // Playlists (stored in the library).
    in property <[PlaylistItem]> playlists;
    in-out property <int> selected-playlist: -1;
    in property <string> playlist-title;
    in property <string> playlist-meta;
    in property <image> playlist-artwork;
    in property <[PlaylistTrackRow]> playlist-tracks;
    callback create-playlist();
    callback open-playlist(int);
    callback play-playlist-row(int);
    callback remove-playlist-entry(int);
    in-out property <bool> is-playlist-editor-open;
    in-out property <string> playlist-editor-name;
    in property <image> playlist-editor-artwork;
    callback playlist-editor-choose-artwork();
    callback playlist-editor-remove-artwork();
    callback begin-playlist-edit();
    callback save-playlist-edit();
    callback delete-current-playlist();
    callback export-current-playlist();
    // "Ajouter à une playlist" sheet, for an album or one of its tracks.
    in-out property <bool> is-add-to-playlist-open;
    in property <string> add-to-playlist-subject;
    callback add-pending-to-playlist(int);
    callback add-pending-to-new-playlist();
    // The play queue ("À suivre"): tracks queued by hand play before the rest of the album or
    // playlist being played.
    callback track-action(TrackTarget, TrackAction);
    // "Afficher dans le Finder" / "Afficher dans l'Explorateur" / "Ouvrir le dossier".
    in property <string> reveal-label: "Afficher dans le Finder";
    in-out property <bool> is-queue-open;
    in property <bool> has-queue-current;
    in property <QueueRow> queue-current;
    in property <[QueueRow]> queue-up-next;
    in property <[QueueRow]> queue-upcoming;
    in property <string> queue-context-name;
    callback queue-remove(int);
    callback queue-clear();
    callback queue-play-up-next(int);
    callback queue-play-upcoming(int);
    // Self-update: a newer release was found on GitHub.
    in property <bool> is-update-available;
    in property <string> current-version;
    in property <string> update-version;
    in property <string> update-notes;
    in property <string> update-status;
    in property <bool> is-updating;
    in-out property <bool> is-update-panel-open;
    callback start-update();
    // Settings page: library folders and update check.
    in property <[string]> library-folders;
    callback remove-library-folder(int);
    callback rescan-library();
    callback check-for-updates();
    in property <string> update-check-status;
    // Album grid order.
    in property <[string]> album-sort-labels;
    in property <int> album-sort-index;
    callback set-album-sort(int);
    // Artists view: one card per album artist; opening one shows its albums in the grid.
    in property <[ArtistCard]> artists;
    in-out property <string> artist-filter;
    // "Ajouts récents": the newest albums, then the ones played last.
    in property <[AlbumCard]> recently-added-albums;
    in property <[AlbumCard]> recently-played-albums;
    callback open-artist(int);
    // "Morceaux" table: every track, sorted by one column (index in display order).
    in property <[LibraryTrackRow]> library-tracks;
    in property <string> current-track-path;
    in property <int> track-sort-column;
    in property <bool> is-track-sort-descending;
    callback sort-tracks(int);
    callback play-library-track(int);
    callback show-all-albums();
    // Tracks matching the search, listed under the matching albums.
    in property <[PlaylistTrackRow]> search-tracks;
    callback play-search-result(int);
    callback begin-album-edit(int);
    callback editor-choose-artwork();
    callback editor-reset-artwork();
    callback save-album-edit();
    callback cancel-album-edit();

    public function show-now-playing() {
        if has-current-track && view != ViewKind.now-playing {
            previous-view = view;
            is-popover-open = false;
            view = ViewKind.now-playing;
        }
    }

    // Filled by Rust.
    in property <[AlbumCard]> albums;
    in property <string> no-results-text;
    in property <string> lcd-title;
    in property <string> lcd-subtitle;
    in property <image> lcd-artwork;
    in property <float> progress;
    in property <string> elapsed-label;
    in property <string> remaining-label;
    in property <bool> is-playing: false;
    in property <string> badge-label;
    in property <bool> is-shared;
    // A stream is open (playing or paused with the device held); false = output released.
    in property <bool> is-output-active;
    in property <bool> is-bit-perfect: false;
    in property <string> signal-title;
    in property <string> signal-description;
    in property <string> md5-label;
    in property <[PathStep]> path-steps;
    in property <[float]> equalizer-levels;
    in property <int> playing-album-index;
    in property <int> playing-track-index;
    in property <int> detail-album-index;
    in property <DetailInfo> detail;
    in property <[TrackRowData]> detail-tracks;
    in property <[PathStep]> detail-path-steps;
    in property <string> detail-badge-label;
    in property <bool> detail-is-bit-perfect: false;

    // UI state owned by Slint (Rust may read or reset it).
    in-out property <bool> is-dark: true;
    // Shared-mode volume: 0 dB (full level) to -60 dB, or muted. Greyed in exclusive mode,
    // where the DAC sets the level and Pistolame applies no gain.
    in property <float> volume-decibels: 0;
    in property <bool> is-volume-muted;
    in property <string> volume-label: "0 dB";
    in property <string> volume-description;
    in-out property <int> selected-item: 2;
    in-out property <ViewKind> view: ViewKind.grid;
    in-out property <bool> is-popover-open;
    in-out property <bool> is-shuffle-on;
    in-out property <bool> is-repeat-on;
    in-out property <length> grid-scroll-y;
    in-out property <length> detail-scroll-y;
    in-out property <string> query;

    // Events handled by Rust.
    callback search-changed(string);
    callback open-album(int);
    callback play-track(int, int);
    callback play-detail-album();
    callback shuffle-detail-album();
    callback toggle-play();
    callback previous-track();
    callback next-track();
    callback seek(float);
    callback volume-changed(float, bool);
    callback toggle-theme();
    // "⌘" on macOS, "Ctrl+" elsewhere, for the shortcut list.
    in property <string> shortcut-modifier: "Ctrl+";

    public function select-item(item: int) {
        selected-item = item;
        is-popover-open = false;
        view = item == 2 ? ViewKind.grid : ViewKind.placeholder;
        if item == 2 && artist-filter != "" {
            artist-filter = "";
            show-all-albums();
        }
    }

    public function show-album(catalog-index: int) {
        view = ViewKind.detail;
        detail-scroll-y = 0px;
        open-album(catalog-index);
    }

    public function go-back() {
        view = view == ViewKind.now-playing ? previous-view : ViewKind.grid;
    }

    public function edit-query(text: string) {
        query = text;
        artist-filter = "";
        selected-item = 2;
        view = ViewKind.grid;
        grid-scroll-y = 0px;
        search-changed(text);
    }
}
